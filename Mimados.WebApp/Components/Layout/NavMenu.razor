@inject NavigationManager Navegacion
@implements IDisposable

<nav class="mt-2">
    <ul class="nav sidebar-menu flex-column" data-lte-toggle="treeview" role="menu">
        @if (EsAdmin)
        {
            <li class="nav-header text-uppercase text-secondary mt-2">PRINCIPAL</li>
            <li class="nav-item">
                <NavLink class="nav-link" href="admin/inicio" Match="NavLinkMatch.All" title="Inicio">
                    <i class="nav-icon bi bi-house-door-fill"></i>
                    <p>Inicio</p>
                </NavLink>
            </li>
            <li class="nav-item">
                <NavLink class="nav-link" href="admin/perfil" Match="NavLinkMatch.All" title="Mi Perfil">
                    <i class="nav-icon bi bi-person"></i>
                    <p>Mi Perfil</p>
                </NavLink>
            </li>

            <li class="nav-header text-uppercase text-secondary mt-2">GESTIÓN</li>
            <li class="nav-item">
                <NavLink class="nav-link" href="sede/administrar" Match="NavLinkMatch.Prefix" title="Sedes">
                    <i class="nav-icon bi bi-building"></i>
                    <p>Sedes</p>
                </NavLink>
            </li>
            <li class="nav-item">
                <NavLink class="nav-link" href="servicio/administrar" Match="NavLinkMatch.Prefix" title="Servicios">
                    <i class="nav-icon bi bi-briefcase"></i>
                    <p>Servicios</p>
                </NavLink>
            </li>
            <li class="nav-item">
                <NavLink class="nav-link" href="empleados" Match="NavLinkMatch.Prefix" title="Empleados">
                    <i class="nav-icon bi bi-people-fill"></i>
                    <p>Empleados</p>
                </NavLink>
            </li>
            <li class="nav-item">
                <NavLink class="nav-link" href="horarios" Match="NavLinkMatch.Prefix" title="Horarios">
                    <i class="nav-icon bi bi-clock-fill"></i>
                    <p>Horarios</p>
                </NavLink>
            </li>

            <li class="nav-header text-uppercase text-secondary mt-2">REPORTES</li>
            <li class="nav-item">
                <NavLink class="nav-link" href="reportes/citas" Match="NavLinkMatch.Prefix" title="Reporte de Citas">
                    <i class="nav-icon bi bi-file-earmark-bar-graph-fill"></i>
                    <p>Reporte de Citas</p>
                </NavLink>
            </li>
            <li class="nav-item">
                <NavLink class="nav-link" href="reporte/servicios" Match="NavLinkMatch.Prefix" title="Reporte de Servicios">
                    <i class="nav-icon bi bi-graph-up"></i>
                    <p>Reporte de Servicios</p>
                </NavLink>
            </li>
        }
        else if (EsPersonalVeterinario)
        {
            <li class="nav-header text-uppercase text-secondary mt-2">OPERACIÓN CLÍNICA</li>
            <li class="nav-item">
                <NavLink class="nav-link" href="empleado/citas" Match="NavLinkMatch.Prefix" title="Gestión de Citas">
                    <i class="nav-icon bi bi-calendar3"></i>
                    <p>Gestión de Citas</p>
                </NavLink>
            </li>
            <li class="nav-item">
                <NavLink class="nav-link" href="veterinario/historial" Match="NavLinkMatch.Prefix" title="Historial de Pacientes">
                    <i class="nav-icon bi bi-journal-medical"></i>
                    <p>Historial de Pacientes</p>
                </NavLink>
            </li>
            <li class="nav-item">
                <NavLink class="nav-link" href="veterinario/atenciones/nueva" Match="NavLinkMatch.All" title="Registrar Atención">
                    <i class="nav-icon bi bi-clipboard2-pulse-fill"></i>
                    <p>Registrar Atención</p>
                </NavLink>
            </li>
        }
        else
        {
            <li class="nav-header text-uppercase text-secondary mt-2">MI ESPACIO</li>
            <li class="nav-item">
                <NavLink class="nav-link" href="cliente/inicio" Match="NavLinkMatch.All" title="Inicio">
                    <i class="nav-icon bi bi-house-door"></i>
                    <p>Inicio</p>
                </NavLink>
            </li>
            <li class="nav-item">
                <NavLink class="nav-link" href="cliente/perfil" Match="NavLinkMatch.All" title="Mi Perfil">
                    <i class="nav-icon bi bi-person"></i>
                    <p>Mi Perfil</p>
                </NavLink>
            </li>
            <li class="nav-item">
                <NavLink class="nav-link" href="cliente/mascotas" Match="NavLinkMatch.Prefix" title="Mis Mascotas">
                    <i class="nav-icon bi bi-heart-pulse"></i>
                    <p>Mis Mascotas</p>
                </NavLink>
            </li>
            <li class="nav-item">
                <NavLink class="nav-link" href="cliente/citas" Match="NavLinkMatch.All" title="Mis Citas">
                    <i class="nav-icon bi bi-calendar-check"></i>
                    <p>Mis Citas</p>
                </NavLink>
            </li>
            <li class="nav-item">
                <NavLink class="nav-link" href="cliente/citas/nueva" Match="NavLinkMatch.All" title="Reservar Cita">
                    <i class="nav-icon bi bi-calendar-plus"></i>
                    <p>Reservar Cita</p>
                </NavLink>
            </li>
        }

        <li class="nav-item">
            <a href="#" class="nav-link" data-bs-toggle="modal" data-bs-target="#contactanosModal" title="Contáctanos">
                <i class="nav-icon bi bi-telephone"></i>
                <p>Contáctanos</p>
            </a>
        </li>
    </ul>
</nav>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private System.Security.Claims.ClaimsPrincipal? _currentUser;

    private bool EsAdmin =>
        (_currentUser?.Identity?.IsAuthenticated == true &&
         (_currentUser.IsInRole("Admin") || _currentUser.IsInRole("Administrador"))) ||
        Navegacion.Uri.Contains("/admin", StringComparison.OrdinalIgnoreCase) ||
        Navegacion.Uri.Contains("/empleados", StringComparison.OrdinalIgnoreCase) ||
        Navegacion.Uri.Contains("/horarios", StringComparison.OrdinalIgnoreCase) ||
        Navegacion.Uri.Contains("/reporte", StringComparison.OrdinalIgnoreCase) ||
        Navegacion.Uri.Contains("/sede", StringComparison.OrdinalIgnoreCase) ||
        Navegacion.Uri.Contains("/servicio", StringComparison.OrdinalIgnoreCase);

    private bool EsPersonalVeterinario =>
        !EsAdmin && (
            (_currentUser?.Identity?.IsAuthenticated == true &&
             (_currentUser.IsInRole("Veterinario") || _currentUser.IsInRole("Empleado"))) ||
            Navegacion.Uri.Contains("/empleado/", StringComparison.OrdinalIgnoreCase) ||
            Navegacion.Uri.Contains("/veterinario", StringComparison.OrdinalIgnoreCase)
        );

    protected override async Task OnInitializedAsync()
    {
        Navegacion.LocationChanged += ActualizarMenu;
        await CargarUsuarioAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        await CargarUsuarioAsync();
    }

    private async Task CargarUsuarioAsync()
    {
        if (AuthStateTask != null)
        {
            var authState = await AuthStateTask;
            _currentUser = authState.User;
        }
    }

    private void ActualizarMenu(object? sender, LocationChangedEventArgs e)
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Navegacion.LocationChanged -= ActualizarMenu;
    }
}
