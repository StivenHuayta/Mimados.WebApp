@page "/horarios"
@using Mimados.WebApp.Models
@using Mimados.WebApp.Services
@inject IHorarioLaboralService HorarioService
@inject IEmpleadoService EmpleadoService

<div class="mb-4">
    <h3 class="m-0 text-dark fw-bold">Gestión de Horarios del Personal</h3>
</div>

@if (!string.IsNullOrEmpty(mensajeAlerta))
{
    <div class="alert alert-info mb-3">@mensajeAlerta</div>
}

<div class="row g-4">
    <!-- Formulario para asignar horario -->
    <div class="col-lg-4">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-primary text-white">
                <h5 class="card-title m-0 fw-bold">Asignar Horario</h5>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label fw-bold">Veterinario</label>
                    <select class="form-select" @bind="nuevoHorario.EmpleadoId">
                        <option value="0">Seleccione un veterinario...</option>
                        @if (listaEmpleados != null)
                        {
                            @foreach (var emp in listaEmpleados)
                            {
                                <option value="@emp.Id">@emp.Nombres @emp.Apellidos</option>
                            }
                        }
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Día de la semana</label>
                    <select class="form-select" @bind="nuevoHorario.DiaSemana">
                        <option value="LUNES">Lunes</option>
                        <option value="MARTES">Martes</option>
                        <option value="MIERCOLES">Miércoles</option>
                        <option value="JUEVES">Jueves</option>
                        <option value="VIERNES">Viernes</option>
                        <option value="SABADO">Sábado</option>
                    </select>
                </div>
                <div class="row">
                    <div class="col-6 mb-3">
                        <label class="form-label fw-bold">Hora Inicio</label>
                        <!-- Usamos @bind a variables TimeOnly locales -->
                        <input type="time" class="form-control" @bind="horaInicioLocal" />
                    </div>
                    <div class="col-6 mb-3">
                        <label class="form-label fw-bold">Hora Fin</label>
                        <input type="time" class="form-control" @bind="horaFinLocal" />
                    </div>
                </div>
                <button class="btn btn-primary w-100 fw-bold mt-2" @onclick="GuardarHorario" disabled="@cargando">
                    @(cargando ? "Guardando..." : "Guardar Horario")
                </button>
            </div>
        </div>
    </div>

    <!-- Tabla con horarios registrados -->
    <div class="col-lg-8">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-primary text-white">
                <h5 class="card-title m-0 fw-bold">Horarios Asignados</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-striped table-hover align-middle mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th>Veterinario</th>
                                <th>Día</th>
                                <th>Horario</th>
                                <th>Estado</th>
                                <th class="text-center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (listaEmpleados == null)
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-3">Cargando datos...</td>
                                </tr>
                            }
                            else if (!listaEmpleados.Any())
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-3">No hay empleados registrados.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var emp in listaEmpleados)
                                {
                                    @if (horariosPorEmpleado.ContainsKey(emp.Id.GetValueOrDefault()))
                                    {
                                        @foreach (var hor in horariosPorEmpleado[emp.Id.GetValueOrDefault()])
                                        {
                                            <tr>
                                                <td>
                                                    @if (!emp.EsAdmin)
                                                    {
                                                        <text>Dr/a. </text>
                                                    }
                                                    @emp.Nombres @emp.Apellidos
                                                </td>
                                                <td>@hor.DiaSemana</td>
                                                <td>@hor.HoraInicio - @hor.HoraFin</td>
                                                <td>
                                                    @if (hor.Activo)
                                                    {
                                                        <span class="badge badge-mimados-primary">Activo</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge badge-mimados-danger">Inactivo</span>
                                                    }
                                                </td>
                                                <td class="text-center">
                                                    <button class="btn btn-sm btn-outline-danger fw-semibold" @onclick="() => EliminarHorario(hor.Id)">Eliminar</button>
                                                </td>
                                            </tr>
                                        }
                                    }
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private HorarioRequest nuevoHorario = new HorarioRequest { DiaSemana = "LUNES" };
    
    // Variables locales TimeOnly para el binding del HTML
    private TimeOnly horaInicioLocal = new TimeOnly(8, 0);
    private TimeOnly horaFinLocal = new TimeOnly(14, 0);

    private List<EmpleadoRequest>? listaEmpleados;
    private Dictionary<int, List<HorarioRequest>> horariosPorEmpleado = new Dictionary<int, List<HorarioRequest>>();
    
    private string? mensajeAlerta;
    private bool cargando = false;

    protected override async Task OnInitializedAsync()
    {
        await CargarDatosGenerales();
    }

    private async Task CargarDatosGenerales()
    {
        try
        {
            var respuestaEmp = await EmpleadoService.ListarEmpleadosAsync();
            if (respuestaEmp != null && respuestaEmp.Success && respuestaEmp.Data != null)
            {
                listaEmpleados = respuestaEmp.Data;
                horariosPorEmpleado.Clear();

                foreach (var emp in listaEmpleados)
                {
                    if (emp.Id.HasValue)
                    {
                        var respuestaHor = await HorarioService.ListarPorEmpleadoAsync(emp.Id.Value);
                        if (respuestaHor != null && respuestaHor.Success && respuestaHor.Data != null)
                        {
                            horariosPorEmpleado[emp.Id.Value] = respuestaHor.Data;
                        }
                    }
                }
            }
        }
        catch (Exception)
        {
            mensajeAlerta = "No se pudieron cargar los horarios en este momento.";
        }
    }

    private async Task GuardarHorario()
    {
        if (nuevoHorario.EmpleadoId == 0)
        {
            mensajeAlerta = "Debe seleccionar un empleado.";
            return;
        }

        cargando = true;
        mensajeAlerta = null;

        // Convertimos las variables TimeOnly a string con formato "HH:mm:ss" antes de enviar
        nuevoHorario.HoraInicio = horaInicioLocal.ToString("HH:mm:ss");
        nuevoHorario.HoraFin = horaFinLocal.ToString("HH:mm:ss");

        try
        {
            var respuesta = await HorarioService.RegistrarHorarioAsync(nuevoHorario);
            if (respuesta != null && respuesta.Success)
            {
                await CargarDatosGenerales();
                // Reiniciamos valores visuales
                horaInicioLocal = new TimeOnly(8, 0);
                horaFinLocal = new TimeOnly(14, 0);
                mensajeAlerta = "Horario asignado exitosamente.";
            }
            else
            {
                mensajeAlerta = respuesta?.Message ?? "Error al registrar el horario.";
            }
        }
        catch (Exception)
        {
            mensajeAlerta = "No se pudo conectar con el servidor. Inténtalo nuevamente.";
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task EliminarHorario(int? idHorario)
    {
        if (idHorario.HasValue)
        {
            try
            {
                var respuesta = await HorarioService.EliminarHorarioAsync(idHorario.Value);
                if (respuesta != null && respuesta.Success)
                {
                    await CargarDatosGenerales();
                    mensajeAlerta = "Horario eliminado correctamente.";
                }
                else
                {
                    mensajeAlerta = respuesta?.Message ?? "No se pudo eliminar el horario.";
                }
            }
            catch (Exception)
            {
                mensajeAlerta = "Error al intentar eliminar el horario.";
            }
        }
    }
}
