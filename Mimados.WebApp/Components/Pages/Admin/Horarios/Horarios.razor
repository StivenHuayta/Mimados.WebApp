@page "/horarios"
@rendermode InteractiveServer
@using Mimados.WebApp.Models
@using Mimados.WebApp.Services
@inject IHorarioLaboralService HorarioService
@inject IEmpleadoService EmpleadoService

<div class="mb-4">
    <h3 class="m-0 text-dark fw-bold">Gestión de Horarios del Personal</h3>
</div>

@if (!string.IsNullOrEmpty(mensajeAlerta))
{
    <div class="alert alert-info mb-3">@mensajeAlerta</div>
}

<div class="row g-4">
    <!-- Formulario para asignar horario -->
    <div class="col-lg-4">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-primary text-white">
                <h5 class="card-title m-0 fw-bold">Asignar Horario</h5>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label fw-bold">Veterinario</label>
                    <select class="form-select" @bind="nuevoHorario.EmpleadoId">
                        <option value="0">Seleccione un veterinario...</option>
                        @if (listaEmpleados != null)
                        {
                            @foreach (var emp in listaEmpleados)
                            {
                                <option value="@emp.Id">@emp.Nombres @emp.Apellidos</option>
                            }
                        }
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Día de la semana</label>
                    <select class="form-select" @bind="nuevoHorario.DiaSemana">
                        <option value="LUNES">Lunes</option>
                        <option value="MARTES">Martes</option>
                        <option value="MIERCOLES">Miércoles</option>
                        <option value="JUEVES">Jueves</option>
                        <option value="VIERNES">Viernes</option>
                        <option value="SABADO">Sábado</option>
                    </select>
                </div>
                <div class="row">
                    <div class="col-6 mb-3">
                        <label class="form-label fw-bold">Hora Inicio</label>
                        <input type="time" class="form-control" @bind="horaInicioLocal" />
                    </div>
                    <div class="col-6 mb-3">
                        <label class="form-label fw-bold">Hora Fin</label>
                        <input type="time" class="form-control" @bind="horaFinLocal" />
                    </div>
                </div>
                <button class="btn btn-primary w-100 fw-bold mt-2" @onclick="GuardarHorario" disabled="@cargando">
                    @(cargando ? "Guardando..." : "Guardar Horario")
                </button>
            </div>
        </div>
    </div>

    <!-- Tabla con horarios registrados -->
    <div class="col-lg-8">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-primary text-white">
                <h5 class="card-title m-0 fw-bold">Horarios Asignados</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-striped table-hover align-middle mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th>Veterinario</th>
                                <th>Día</th>
                                <th>Horario</th>
                                <th>Estado</th>
                                <th class="text-center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (listaEmpleados == null)
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-3">Cargando datos...</td>
                                </tr>
                            }
                            else if (!listaEmpleados.Any())
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-3">No hay veterinarios registrados.</td>
                                </tr>
                            }
                            else if (!horariosPorEmpleado.Any())
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-3 text-muted">No hay horarios asignados todavía.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var emp in listaEmpleados)
                                {
                                    @if (horariosPorEmpleado.ContainsKey(emp.Id))
                                    {
                                        @foreach (var hor in horariosPorEmpleado[emp.Id])
                                        {
                                            <tr>
                                                <td>
                                                    @if (emp.EsVeterinario)
                                                    {
                                                        <text>Dr/a. </text>
                                                    }
                                                    @emp.Nombres @emp.Apellidos
                                                </td>
                                                <td>@hor.DiaSemana</td>
                                                <td>@hor.HoraInicio - @hor.HoraFin</td>
                                                <td>
                                                    @if (hor.Activo)
                                                    {
                                                        <span class="badge badge-mimados-primary">Activo</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge badge-mimados-danger">Inactivo</span>
                                                    }
                                                </td>
                                                <td class="text-center">
                                                    <button class="btn btn-sm btn-outline-primary fw-semibold" @onclick="() => AbrirModalEdicion(hor, emp)">Editar</button>
                                                    <button class="btn btn-sm btn-outline-danger fw-semibold ms-1" @onclick="() => AbrirModalEliminar(hor, emp)">Eliminar</button>
                                                </td>
                                            </tr>
                                        }
                                    }
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal de Edición -->
@if (mostrarModal && horarioEditando != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title fw-bold">Editar Horario: @nombreVeterinarioEditando</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CerrarModal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Día de la semana</label>
                        <select class="form-select" @bind="horarioEditando.DiaSemana">
                            <option value="LUNES">Lunes</option>
                            <option value="MARTES">Martes</option>
                            <option value="MIERCOLES">Miércoles</option>
                            <option value="JUEVES">Jueves</option>
                            <option value="VIERNES">Viernes</option>
                            <option value="SABADO">Sábado</option>
                        </select>
                    </div>
                    <div class="row">
                        <div class="col-6 mb-3">
                            <label class="form-label fw-bold">Hora Inicio</label>
                            <input type="time" class="form-control" @bind="horaInicioEdicion" />
                        </div>
                        <div class="col-6 mb-3">
                            <label class="form-label fw-bold">Hora Fin</label>
                            <input type="time" class="form-control" @bind="horaFinEdicion" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-outline-secondary" @onclick="CerrarModal" disabled="@cargando">Cancelar</button>
                    <button type="button" class="btn btn-primary fw-bold" @onclick="GuardarEdicion" disabled="@cargando">
                        @(cargando ? "Guardando..." : "Guardar Cambios")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Modal de Confirmación de Eliminación -->
@if (mostrarModalEliminar && horarioAEliminar != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title fw-bold">Confirmar Eliminación</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CerrarModalEliminar"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-2">¿Estás seguro de que deseas eliminar este horario?</p>
                    <div class="p-3 bg-light rounded border">
                        <div><strong>Veterinario:</strong> @nombreVeterinarioEliminar</div>
                        <div><strong>Día:</strong> @horarioAEliminar.DiaSemana</div>
                        <div><strong>Turno:</strong> @horarioAEliminar.HoraInicio - @horarioAEliminar.HoraFin</div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-outline-secondary" @onclick="CerrarModalEliminar" disabled="@cargando">Cancelar</button>
                    <button type="button" class="btn btn-danger fw-bold" @onclick="ConfirmarEliminarHorario" disabled="@cargando">
                        @(cargando ? "Eliminando..." : "Sí, eliminar")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private HorarioLaboral nuevoHorario = new HorarioLaboral { DiaSemana = "LUNES", Activo = true };

    private TimeOnly horaInicioLocal = new TimeOnly(8, 0);
    private TimeOnly horaFinLocal = new TimeOnly(14, 0);

    private List<Empleado>? listaEmpleados;
    private Dictionary<int, List<HorarioLaboral>> horariosPorEmpleado = new();

    private string? mensajeAlerta;
    private bool cargando = false;

    // Variables para el modal de edición
    private bool mostrarModal = false;
    private HorarioLaboral? horarioEditando;
    private string nombreVeterinarioEditando = string.Empty;
    private TimeOnly horaInicioEdicion;
    private TimeOnly horaFinEdicion;
    private string estadoEdicion = "true";

    // Variables para el modal de eliminación
    private bool mostrarModalEliminar = false;
    private HorarioLaboral? horarioAEliminar;
    private string nombreVeterinarioEliminar = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await CargarDatosGenerales();
    }

    private async Task CargarDatosGenerales()
    {
        try
        {
            var todosLosEmpleados = await EmpleadoService.ListarEmpleadosAsync();
            listaEmpleados = todosLosEmpleados.Where(e => e.EsVeterinario).ToList();

            horariosPorEmpleado.Clear();

            foreach (var emp in listaEmpleados)
            {
                if (emp.Id > 0)
                {
                    var horarios = await HorarioService.ListarPorEmpleadoAsync(emp.Id);
                    if (horarios.Any())
                    {
                        horariosPorEmpleado[emp.Id] = horarios;
                    }
                }
            }
        }
        catch (Exception)
        {
            mensajeAlerta = "No se pudieron cargar los horarios en este momento.";
            listaEmpleados = new List<Empleado>();
        }
    }

    private async Task GuardarHorario()
    {
        if (nuevoHorario.EmpleadoId == 0)
        {
            mensajeAlerta = "Debe seleccionar un veterinario.";
            return;
        }

        if (horaFinLocal <= horaInicioLocal)
        {
            mensajeAlerta = "La hora de fin debe ser posterior a la hora de inicio.";
            return;
        }

        cargando = true;
        mensajeAlerta = null;

        nuevoHorario.HoraInicio = horaInicioLocal.ToString("HH:mm");
        nuevoHorario.HoraFin = horaFinLocal.ToString("HH:mm");
        nuevoHorario.Activo = true;

        try
        {
            bool exito = await HorarioService.RegistrarHorarioAsync(nuevoHorario);
            if (exito)
            {
                int empSeleccionado = nuevoHorario.EmpleadoId;
                nuevoHorario = new HorarioLaboral
                {
                    EmpleadoId = empSeleccionado,
                    DiaSemana = "LUNES",
                    Activo = true
                };
                horaInicioLocal = new TimeOnly(8, 0);
                horaFinLocal = new TimeOnly(14, 0);

                await CargarDatosGenerales();
                mensajeAlerta = "Horario asignado exitosamente.";
            }
            else
            {
                mensajeAlerta = "Error al registrar el horario. Verifica que no se cruce con otro turno ni exceda el horario de la sede.";
            }
        }
        catch (Exception)
        {
            mensajeAlerta = "No se pudo conectar con el servidor. Inténtalo nuevamente.";
        }
        finally
        {
            cargando = false;
        }
    }

    private void AbrirModalEdicion(HorarioLaboral hor, Empleado emp)
    {
        horarioEditando = new HorarioLaboral
        {
            Id = hor.Id,
            EmpleadoId = emp.Id,
            DiaSemana = hor.DiaSemana,
            Activo = hor.Activo
        };
        nombreVeterinarioEditando = $"{emp.Nombres} {emp.Apellidos}";
        TimeOnly.TryParse(hor.HoraInicio, out horaInicioEdicion);
        TimeOnly.TryParse(hor.HoraFin, out horaFinEdicion);
        estadoEdicion = hor.Activo ? "true" : "false";
        mostrarModal = true;
    }

    private void CerrarModal()
    {
        mostrarModal = false;
        horarioEditando = null;
    }

    private async Task GuardarEdicion()
    {
        if (horarioEditando == null) return;

        if (horaFinEdicion <= horaInicioEdicion)
        {
            mensajeAlerta = "La hora de fin debe ser posterior a la hora de inicio.";
            return;
        }

        cargando = true;
        mensajeAlerta = null;

        horarioEditando.HoraInicio = horaInicioEdicion.ToString("HH:mm");
        horarioEditando.HoraFin = horaFinEdicion.ToString("HH:mm");
        horarioEditando.Activo = (estadoEdicion == "true");

        try
        {
            bool exito = await HorarioService.ModificarHorarioAsync(horarioEditando);
            if (exito)
            {
                CerrarModal();
                await CargarDatosGenerales();
                mensajeAlerta = "Horario modificado correctamente.";
            }
            else
            {
                mensajeAlerta = "No se pudo modificar el horario.";
            }
        }
        catch (Exception)
        {
            mensajeAlerta = "Error de conexión al intentar modificar el horario.";
        }
        finally
        {
            cargando = false;
        }
    }

    private void AbrirModalEliminar(HorarioLaboral hor, Empleado emp)
    {
        horarioAEliminar = hor;
        nombreVeterinarioEliminar = $"Dr/a. {emp.Nombres} {emp.Apellidos}";
        mostrarModalEliminar = true;
    }

    private void CerrarModalEliminar()
    {
        mostrarModalEliminar = false;
        horarioAEliminar = null;
    }

    private async Task ConfirmarEliminarHorario()
    {
        if (horarioAEliminar == null || horarioAEliminar.Id <= 0) return;

        cargando = true;
        mensajeAlerta = null;

        try
        {
            bool exito = await HorarioService.EliminarHorarioAsync(horarioAEliminar.Id);
            if (exito)
            {
                CerrarModalEliminar();
                await CargarDatosGenerales();
                mensajeAlerta = "Horario eliminado correctamente.";
            }
            else
            {
                mensajeAlerta = "No se pudo eliminar el horario.";
            }
        }
        catch (Exception)
        {
            mensajeAlerta = "Error al intentar eliminar el horario.";
        }
        finally
        {
            cargando = false;
        }
    }
}
