@page "/admin/inicio"
@rendermode InteractiveServer

<AuthorizeView Roles="Admin, Administrador">
    <Authorized Context="auth">
        <div class="mb-4">
            <h3 class="m-0 text-dark fw-bold">Hola @(auth.User.FindFirst("DisplayName")?.Value ?? "Administrador")</h3>
            <p class="text-muted">Bienvenido al panel de administración de Clínica Veterinaria Mimados.</p>
        </div>

        <div class="row g-4">
            <!-- Tarjeta de Empleados -->
            <div class="col-lg-4 col-md-6">
                <div class="card shadow-sm h-100">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <p class="text-muted small text-uppercase fw-semibold mb-1">Personal</p>
                                <h3 class="fw-bold mb-0 text-dark">12</h3>
                                <p class="mb-0 text-secondary">Empleados</p>
                            </div>
                            <div class="d-inline-flex align-items-center justify-content-center rounded-3 bg-primary-subtle text-primary" style="width: 56px; height: 56px;">
                                <i class="bi bi-people-fill fs-3"></i>
                            </div>
                        </div>
                    </div>
                    <a href="/empleados" class="card-footer bg-white text-primary fw-semibold text-center text-decoration-none py-2">
                        Gestionar personal <i class="bi bi-arrow-right-circle ms-1"></i>
                    </a>
                </div>
            </div>

            <!-- Tarjeta de Horarios -->
            <div class="col-lg-4 col-md-6">
                <div class="card shadow-sm h-100">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <p class="text-muted small text-uppercase fw-semibold mb-1">Turnos</p>
                                <h3 class="fw-bold mb-0 text-dark">Activos</h3>
                                <p class="mb-0 text-secondary">Horarios</p>
                            </div>
                            <div class="d-inline-flex align-items-center justify-content-center rounded-3 bg-primary-subtle text-primary" style="width: 56px; height: 56px;">
                                <i class="bi bi-clock-fill fs-3"></i>
                            </div>
                        </div>
                    </div>
                    <a href="/horarios" class="card-footer bg-white text-primary fw-semibold text-center text-decoration-none py-2">
                        Asignar turnos <i class="bi bi-arrow-right-circle ms-1"></i>
                    </a>
                </div>
            </div>

            <!-- Tarjeta de Reportes -->
            <div class="col-lg-4 col-md-6">
                <div class="card shadow-sm h-100">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <p class="text-muted small text-uppercase fw-semibold mb-1">Analítica</p>
                                <h3 class="fw-bold mb-0 text-dark">Citas</h3>
                                <p class="mb-0 text-secondary">Reportes Generales</p>
                            </div>
                            <div class="d-inline-flex align-items-center justify-content-center rounded-3 bg-primary-subtle text-primary" style="width: 56px; height: 56px;">
                                <i class="bi bi-file-earmark-bar-graph-fill fs-3"></i>
                            </div>
                        </div>
                    </div>
                    <a href="/reportes/citas" class="card-footer bg-white text-primary fw-semibold text-center text-decoration-none py-2">
                        Ver historial <i class="bi bi-arrow-right-circle ms-1"></i>
                    </a>
                </div>
            </div>
        </div>
    </Authorized>

    <NotAuthorized>
        <div class="alert alert-warning shadow-sm my-4">
            <h5 class="fw-bold mb-2"><i class="bi bi-exclamation-triangle-fill me-2"></i>Acceso Restringido</h5>
            No posees permisos para ver esto. Por favor, contacta al soporte.
        </div>
        <a href="/login" class="btn btn-outline-primary">
            <i class="bi bi-box-arrow-in-right me-1"></i> Ir al Login
        </a>
    </NotAuthorized>
</AuthorizeView>

