@page "/empleados/nuevo"
@using Mimados.WebApp.Models
@using Mimados.WebApp.Services
@inject NavigationManager Navigation
@inject IEmpleadoService EmpleadoService

<div class="mb-4">
    <h3 class="m-0 text-dark fw-bold">Registrar Empleado</h3>
</div>

@if (!string.IsNullOrEmpty(mensajeAlerta))
{
    <div class="alert alert-warning mb-3">@mensajeAlerta</div>
}

<div class="card shadow-sm border-0">
    <div class="card-header bg-primary text-white">
        <h5 class="card-title m-0 fw-bold">Datos del Empleado</h5>
    </div>
    <div class="card-body">
        <form>
            <div class="row">
                <div class="col-md-4 mb-3">
                    <label class="form-label fw-bold">DNI</label>
                    <input type="text" class="form-control" placeholder="Ingrese DNI (8 dígitos)" maxlength="8" @bind="empleado.Dni" />
                </div>
                <div class="col-md-4 mb-3">
                    <label class="form-label fw-bold">Nombres</label>
                    <input type="text" class="form-control" placeholder="Nombres" @bind="empleado.Nombres" />
                </div>
                <div class="col-md-4 mb-3">
                    <label class="form-label fw-bold">Apellidos</label>
                    <input type="text" class="form-control" placeholder="Apellidos" @bind="empleado.Apellidos" />
                </div>
            </div>

            <div class="row">
                <div class="col-md-4 mb-3">
                    <label class="form-label fw-bold">Teléfono</label>
                    <input type="text" class="form-control" placeholder="999888777" maxlength="9" @bind="empleado.Telefono" />
                </div>
                <div class="col-md-4 mb-3">
                    <label class="form-label fw-bold">Correo Electrónico</label>
                    <input type="email" class="form-control" placeholder="correo@ejemplo.com" @bind="empleado.Email" />
                </div>
                <div class="col-md-4 mb-3">
                    <label class="form-label fw-bold">Fecha de Contratación</label>
                    <input type="date" class="form-control" />
                </div>
            </div>

            <div class="row">
                <div class="col-md-4 mb-3">
                    <label class="form-label fw-bold">Rol</label>
                    <select class="form-select" @bind="rolSeleccionado">
                        <option value="Veterinario">Veterinario</option>
                        <option value="Administrador">Administrador</option>
                    </select>
                </div>
                <div class="col-md-4 mb-3">
                    <label class="form-label fw-bold">Código CMP (Si es veterinario)</label>
                    <input type="text" class="form-control" placeholder="Ej: CMP-10293" @bind="empleado.CodigoCmvp" />
                </div>
                <div class="col-md-4 mb-3">
                    <label class="form-label fw-bold">Sede Asignada</label>
                    <select class="form-select" @bind="empleado.SedeId">
                        <option value="1">Sede Central</option>
                        <option value="2">Sede Norte</option>
                    </select>
                </div>
            </div>

            <div class="row">
                <!-- Se añadió este campo porque la base de datos requiere contraseña para el Login -->
                <div class="col-md-4 mb-3">
                    <label class="form-label fw-bold">Contraseña de Acceso</label>
                    <input type="password" class="form-control" placeholder="Contraseña" @bind="empleado.Password" />
                </div>
            </div>
        </form>
    </div>
    <div class="card-footer bg-light d-flex justify-content-end gap-2">
        <button type="button" class="btn btn-outline-secondary" @onclick="Volver">Cancelar</button>
        <button type="button" class="btn btn-primary fw-bold" @onclick="GuardarEmpleado" disabled="@cargando">
            @(cargando ? "Guardando..." : "Guardar Empleado")
        </button>
    </div>
</div>

@code {
    private EmpleadoRequest empleado = new EmpleadoRequest { SedeId = 1, Activo = true };
    private string rolSeleccionado = "Veterinario";
    private string? mensajeAlerta;
    private bool cargando = false;

    private async Task GuardarEmpleado()
    {
        cargando = true;
        mensajeAlerta = null;

        // Mapear el rol seleccionado al booleano
        empleado.EsAdmin = (rolSeleccionado == "Administrador");

        try
        {
            var respuesta = await EmpleadoService.RegistrarEmpleadoAsync(empleado);

            if (respuesta != null && respuesta.Success)
            {
                Navigation.NavigateTo("/empleados");
            }
            else
            {
                mensajeAlerta = respuesta?.Message ?? "No se pudo registrar el empleado. Verifica los datos.";
            }
        }
        catch (Exception)
        {
            mensajeAlerta = "No se pudo conectar con el servidor. Inténtalo nuevamente.";
        }
        finally
        {
            cargando = false;
        }
    }

    private void Volver()
    {
        Navigation.NavigateTo("/empleados");
    }
}
