@page "/empleados"
@rendermode InteractiveServer
@using Mimados.WebApp.Models
@using Mimados.WebApp.Services 
@inject NavigationManager Navigation
@inject IEmpleadoService EmpleadoService
@inject ISedeService SedeService

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="m-0 text-dark fw-bold">Gestión de Empleados</h3>
    <button class="btn btn-primary fw-bold" @onclick="IrARegistro">
        + Registrar Nuevo Empleado
    </button>
</div>

@if (!string.IsNullOrEmpty(mensajeAlerta))
{
    <div class="alert @(esError ? "alert-danger" : "alert-success") mb-3">@mensajeAlerta</div>
}

<div class="card shadow-sm border-0">
    <div class="card-header bg-primary text-white">
        <h5 class="card-title m-0 fw-bold">Lista de Empleados Registrados</h5>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th>DNI</th>
                        <th>Nombres y Apellidos</th>
                        <th>Teléfono</th>
                        <th>Correo Electrónico</th>
                        <th>Rol</th>
                        <th>Estado</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (listaEmpleados == null)
                    {
                        <tr>
                            <td colspan="7" class="text-center py-3">Cargando empleados...</td>
                        </tr>
                    }
                    else if (!listaEmpleados.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-3">No hay empleados registrados.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var emp in listaEmpleados)
                        {
                            <tr>
                                <td>@emp.Dni</td>
                                <td>@($"{emp.Nombres} {emp.Apellidos}")</td>
                                <td>@emp.Telefono</td>
                                <td>@emp.Email</td>
                                <td>
                                    @if (emp.EsAdmin)
                                    {
                                        <span class="badge bg-primary me-1">Administrador</span>
                                    }
                                    @if (emp.EsVeterinario)
                                    {
                                        <span class="badge bg-info text-dark">Veterinario</span>
                                    }
                                    @if (!emp.EsAdmin && !emp.EsVeterinario)
                                    {
                                        <span class="text-muted small">Sin rol</span>
                                    }
                                </td>
                                <td>
                                    @if (emp.Activo)
                                    {
                                        <span class="badge badge-mimados-primary">Activo</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-mimados-danger">Inactivo</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <button class="btn btn-sm btn-outline-primary fw-semibold" @onclick="() => AbrirModalEdicion(emp)">
                                        Editar
                                    </button>
                                    @if (emp.Activo)
                                    {
                                        <button class="btn btn-sm btn-outline-danger fw-semibold ms-1" @onclick="() => DesactivarEmpleado(emp)">
                                            Eliminar
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@if (mostrarModal && empleadoEditando != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title fw-bold">Editar Empleado: @empleadoEditando.Nombres @empleadoEditando.Apellidos</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CerrarModal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold d-block">Roles del Empleado</label>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" id="chkEditAdmin" @bind="empleadoEditando.EsAdmin" />
                            <label class="form-check-label" for="chkEditAdmin">Administrador</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" id="chkEditVet" @bind="empleadoEditando.EsVeterinario" />
                            <label class="form-check-label" for="chkEditVet">Veterinario</label>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Código CMP (Si es veterinario)</label>
                        <input type="text" class="form-control" @bind="empleadoEditando.CodigoCmvp" @bind:event="oninput" placeholder="Ej: CMP-10293" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Sede Asignada</label>
                        <select class="form-select" @bind="empleadoEditando.SedeId">
                            @if (listaSedes != null)
                            {
                                @foreach (var sede in listaSedes)
                                {
                                    <option value="@sede.Id">@sede.Nombre</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Estado</label>
                        <select class="form-select" @bind="estadoEdicion">
                            <option value="true">Activo</option>
                            <option value="false">Inactivo</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-outline-secondary" @onclick="CerrarModal">Cancelar</button>
                    <button type="button" class="btn btn-primary fw-bold" @onclick="GuardarEdicion" disabled="@guardando">
                        @(guardando ? "Guardando..." : "Guardar Cambios")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<Empleado>? listaEmpleados;
    private string? mensajeAlerta;
    private bool esError = false;
    private bool guardando = false;

    // Variables para el modal de edición
    private bool mostrarModal = false;
    private Empleado? empleadoEditando;
    private string estadoEdicion = "true";
    private List<Sede> listaSedes;

    protected override async Task OnInitializedAsync()
    {
        listaSedes = await SedeService.ObtenerSedesAsync();
        await CargarEmpleados();
    }

    private async Task CargarEmpleados()
    {
        try
        {
            listaEmpleados = await EmpleadoService.ListarEmpleadosAsync();
        }
        catch (Exception)
        {
            esError = true;
            mensajeAlerta = "No se pudieron cargar los empleados en este momento. Inténtalo nuevamente.";
            listaEmpleados = new List<Empleado>();
        }
    }

    private void IrARegistro()
    {
        Navigation.NavigateTo("/empleados/nuevo");
    }

    private void AbrirModalEdicion(Empleado emp)
    {
        empleadoEditando = new Empleado
        {
            Id = emp.Id,
            Dni = emp.Dni,
            Nombres = emp.Nombres,
            Apellidos = emp.Apellidos,
            Email = emp.Email,
            Telefono = emp.Telefono,
            SedeId = emp.SedeId > 0 ? emp.SedeId : 1,
            CodigoCmvp = emp.CodigoCmvp,
            EsAdmin = emp.EsAdmin,
            EsVeterinario = emp.EsVeterinario,
            Activo = emp.Activo
        };
        estadoEdicion = emp.Activo ? "true" : "false";
        mostrarModal = true;
    }

    private void CerrarModal()
    {
        mostrarModal = false;
        empleadoEditando = null;
    }

    private async Task GuardarEdicion()
    {
        if (empleadoEditando == null) return;

        if (!empleadoEditando.EsAdmin && !empleadoEditando.EsVeterinario)
        {
            esError = true;
            mensajeAlerta = "Debe asignar al menos un rol (Administrador o Veterinario).";
            return;
        }

        guardando = true;
        mensajeAlerta = null;

        empleadoEditando.Activo = (estadoEdicion == "true");
        if (!empleadoEditando.EsVeterinario)
        {
            empleadoEditando.CodigoCmvp = null;
        }

        try
        {
            bool exito = await EmpleadoService.ModificarEmpleadoAsync(empleadoEditando);
            if (exito)
            {
                CerrarModal();
                await CargarEmpleados();
                esError = false;
                mensajeAlerta = "Empleado actualizado correctamente.";
            }
            else
            {
                esError = true;
                mensajeAlerta = "No se pudo actualizar el empleado. Verifica los datos.";
            }
        }
        catch (Exception)
        {
            esError = true;
            mensajeAlerta = "Error de conexión al intentar modificar el empleado.";
        }
        finally
        {
            guardando = false;
        }
    }

    private async Task DesactivarEmpleado(Empleado emp)
    {
        mensajeAlerta = null;
        var empDesactivar = new Empleado
        {
            Id = emp.Id,
            SedeId = emp.SedeId > 0 ? emp.SedeId : 1,
            CodigoCmvp = emp.CodigoCmvp,
            EsAdmin = emp.EsAdmin,
            EsVeterinario = emp.EsVeterinario,
            Activo = false
        };

        try
        {
            bool exito = await EmpleadoService.ModificarEmpleadoAsync(empDesactivar);
            if (exito)
            {
                await CargarEmpleados();
                esError = false;
                mensajeAlerta = $"El empleado {emp.Nombres} {emp.Apellidos} ha sido desactivado.";
            }
            else
            {
                esError = true;
                mensajeAlerta = "No se pudo desactivar el empleado.";
            }
        }
        catch (Exception)
        {
            esError = true;
            mensajeAlerta = "Error de conexión al intentar desactivar el empleado.";
        }
    }
}