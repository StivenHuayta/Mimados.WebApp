@page "/sede/administrar"
@inject NavigationManager Nav
@using Mimados.WebApp.Models
@rendermode InteractiveServer
@inject ISedeService SedeService


<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-building-fill me-2"></i>Administrar Sedes</h2>
        
        
            <a href="/sede/crear" class="btn btn-primary shadow-sm">
                <i class="bi bi-building-fill-add me-1"></i>Crear Sede
            </a>

    </div>


    <!-- Filtros -->
    <div class="card mb-4 shadow-sm border-0">
        <div class="card-body">
            <div class="row mb-3">
            <div class="col-12">
                <h5 class="card-title fw-bold text-secondary mb-0">Filtros de Búsqueda</h5>
            </div>
        </div>
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label text-muted small fw-bold">Nombre</label>
                    <input type="text" class="form-control form-control-sm" @bind="filtroNombre" placeholder="Nombre de la sede..." />
                </div>
                <div class="col-md-6">
                    <label class="form-label text-muted small fw-bold">Direccion</label>
                    <input type="text" class="form-control form-control-sm" @bind="filtroDireccion" placeholder="Direccion..." />
                </div>

                <div class="col-md-12 d-flex align-items-end gap-2">
                    <button class="btn btn-primary btn-sm px-4 shadow-sm" @onclick="AplicarFiltros">
                        <i class="bi bi-search me-1"></i>Buscar
                    </button>
                    <button class="btn btn-outline-secondary btn-sm px-4" @onclick="LimpiarFiltros">
                        <i class="bi bi-x-circle me-1"></i>Limpiar
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Tabla paginada de clientes. (tipo de dato a usar, ,onchanged) -->
    <Card Title="Lista de Sedes"
          FooterClass="text-secondary small"
          BodyClass="p-0">
        

        <ChildContent>
        
            @if (cargando)
            {
                <p><em>Cargando sedes...</em></p>
            }
            else if (sedes == null || !sedes.Any())
            {
                <p>No se encontraron sedes registradas.</p>
            }
            else
            {
                @* TODO: a vanilla-JS datatable library (Tabulator/Simple-DataTables) could be
           initialised against this table to make search, sort and pagination live. *@
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th style="width: 60px">
                                #
                            </th>
                            <th>

                                Nombre

                            </th>
                            <th>

                                Direccion

                            </th>
                            <th style="width: 120px">

                                Telefono

                            </th>
                            <th style="width: 130px" class="text-center">Estado</th>
                            <th style="width: 130px">

                                Editar

                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var sed in sedes)
                        {
                            <tr class="align-middle">
                                <td>@sed.Id</td>
                                <td>@sed.Nombre</td>
                                <td>@sed.Direccion</td>
                                <td>@sed.Telefono</td>
                                <td class="text-center align-middle">
                                    @if (sed.Activo)
                                    {

                                        <span class="badge badge-mimados-primary px-2 py-1">Activo</span>
                                    }
                                    else
                                    {

                                        <span class="badge badge-mimados-danger px-2 py-1">Inactivo</span>
                                    }
                                </td>
                                <td>
                                    <a href="@($"/sede/administrar/editar/{sed.Id}")" class="btn btn-outline-primary btn-sm">
                                        <i class="bi bi-eye"></i> Ver
                                    </a>
                                </td>

                            </tr>
                        }
                    </tbody>
                </table>
            }

        
        </ChildContent>
    </Card>
</div>


@code {
    private string filtroNombre;
    private string filtroDireccion;
    private ISedeService sedeService; 
    private List<Sede> sedes=new List<Sede>();

    private bool cargando = true;
    private string mensajeError = "";

//new List<Sede>
//{
    //new Sede(1, "Sede Central - Lima", "Av. Javier Prado 123", "987654321", true),
    // Sede(2, "Sede Norte - Los Olivos", "Av. Alfredo Mendiola 456", "912345678", true)
//};

    protected override async Task OnInitializedAsync()
    {
        await CargarDatos();
    }

    private async Task CargarDatos()
    {
        cargando = true;
        mensajeError = null;

        try
        {
            sedes = await SedeService.ObtenerSedesAsync();
        }
        catch (Exception)
        {
            mensajeError = "No se pudieron cargar las sedes. Inténtalo nuevamente.";
        }
        finally
        {
            cargando = false;
        }
    }


    private void AplicarFiltros(){

    }
    private async Task LimpiarFiltros(){
        filtroDireccion=String.Empty;
        filtroNombre=String.Empty;
        await CargarDatos();

    }

    public void IrAEditarMascota(int id)
    {
        Nav.NavigateTo($"/sede/administrar/editar/{id}");

    }
    
}
