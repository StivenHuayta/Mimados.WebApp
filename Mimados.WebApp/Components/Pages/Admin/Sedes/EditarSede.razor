@page "/sede/administrar/editar/{Id:int}"
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using Mimados.WebApp.Models
@inject NavigationManager Nav
@inject ISedeService SedeService
@inject ISedeServicioService SedeServicioService

<div class="container-fluid mt-4">
    
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Editar Sede</h2>
        <button class="btn btn-secondary" @onclick="Volver">
            <i class="bi bi-arrow-left"></i> Volver a Administrar Sedes
        </button>
    </div>

    @if (editarSede == null)
    {
        <div class="alert alert-info">Cargando datos de la Sede...</div>
    }
    else
    {
        <div class="card p-4 shadow-sm border-0 bg-white">
            
            @* Reutilizamos el EditForm con validación nativa (Diapositiva 39) *@
            <EditForm Model="@editarSede" OnValidSubmit="ActualizarSede">
                <DataAnnotationsValidator />

                <div class="mb-3">
                <label class="form-label fw-bold">Nombre de la Sede:</label>
                <InputText @bind-Value="editarSede.Nombre" class="form-control" placeholder="Ej. Sede ..." />
                <ValidationMessage For="@(() => editarSede.Nombre)" class="text-danger small" />
            </div>

            <div class="row">
                
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">Direccion:</label>
                    <InputText @bind-Value="editarSede.Direccion" class="form-control" placeholder="Ej. Av. ..." />
                    <ValidationMessage For="@(() => editarSede.Direccion)" class="text-danger small" />

                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">Telefono:</label>
                    <InputText @bind-Value="editarSede.Telefono" class="form-control" placeholder="Ej. 999 999 999" />
                    <ValidationMessage For="@(() => editarSede.Telefono)" class="text-danger small" />
                </div>
            </div>

            <div class="form-check form-switch mb-3">

                <InputCheckbox id="estadoActivo" @bind-Value="editarSede.Activo" class="form-check-input switch-activo-rojo" role="switch" />
                <label class="form-check-label" for="estadoActivo">
                    @(editarSede.Activo ? "Activo" : "Inactivo")
                   </label>
            </div>



                <div class="text-end">
                    <button type="submit" class="btn btn-primary px-4 fw-bold">
                        <i class="bi bi-pencil-square"></i> Actualizar Datos
                    </button>
                </div>
            </EditForm>
        </div>


        <div class="mt-4">

        <div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="fw-bold text-secondary m-0">
        <i class="bi bi-list-check text-primary me-2"></i> Listado de Servicios
    </h3>
    <button type="button" class="btn btn-primary" @onclick="AbrirBuscadorServicio">
    <i class="bi bi-plus-circle me-1"></i> Nuevo Servicio
</button>
</div>
    <Card Title="Lista de Servicios"
          FooterClass="text-secondary small"
          BodyClass="p-0">
        

        <ChildContent>
        

        @* TODO: a vanilla-JS datatable library (Tabulator/Simple-DataTables) could be
           initialised against this table to make search, sort and pagination live. *@
        <table class="table table-hover align-middle mb-0">
            <thead class="align-middle ">
                <tr>
                    <th style="width: 60px">
                         #
                    </th>
                    <th>
                            Nombre 
                    </th>
                    <th>
                            Descripcion 
                    </th>
                    <th>
                            Precio referencial 
                    </th>
                    <th>
                            Duracion en minutos
                    </th>
                    
                    <th style="width: 130px" class="text-center">Estado</th>
                    <th style="width: 130px">
                        
                            Editar 
                        
                    </th>
                </tr>
            </thead>
            <tbody>
                            @foreach (var ser in listaServiciosDTO)
                {
                    <tr class="align-middle">
                        <td>@ser.IdServicio</td>
                        <td>@ser.Nombre</td>
                        <td>@ser.Descripcion</td>
                        <td>@ser.PrecioReferencial</td>
                        <td>@ser.DuracionMinutos</td>
                        <td class="text-center align-middle">
                        @if (ser.Activo)
                            {
                                
                                <span class="badge badge-mimados-primary px-2 py-1">Activo</span>
                               }
                        else
                            {

                            <span class="badge badge-mimados-danger px-2 py-1">Inactivo</span>
                            }
                    </td>
                    <td >
                        <button class="btn btn-outline-danger btn-sm" @onclick="() => EliminarSedeServicio(ser.IdSedeServicio)">
                             Desactivar
                        </button>
                    </td>
                        
                    </tr>
                }
            </tbody>
        </table>
        </ChildContent>
    </Card>
    </div>
    }
</div>



@if (mostrarModalServicio)
{
    <div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-4">
                <div class="modal-header bg-primary text-white py-3">
                    <h5 class="modal-title fw-bold"><i class="bi bi-balloon-heart-fill me-2"></i>Buscador de Servicios</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CerrarModalServicio"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="input-group mb-3 shadow-sm">
                        <span class="input-group-text bg-light"><i class="bi bi-funnel text-secondary"></i></span>
                        <input type="text" class="form-control" placeholder="Escriba el nombre del servicio..." 
                               @bind="textoBusquedaServicio" @bind:event="oninput" @onkeyup="FiltrarServicios" />
                        <button class="btn btn-primary px-3" type="button" @onclick="FiltrarServicios">
                            Buscar
                        </button>
                    </div>

                    <div class="table-responsive border rounded-3 bg-white" style="max-height: 250px;">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light sticky-top">
                                <tr>
                                    <th class="text-center" style="width: 120px;">ID</th>
                                    <th>Nombre</th>
                                    <th>Precio</th>
                                    <th>Duración</th>
                                    <th class="text-center" style="width: 120px;">Selección</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (serviciosFiltrados.Any())
                                {
                                    @foreach (var servicio in serviciosFiltrados)
                                    {
                                        <tr>
                                            <td class="text-center"><span class="badge bg-light text-secondary border">@servicio.Id</span></td>
                                            <td class="fw-semibold text-dark">@servicio.Nombre</td>
                                            <td class="text-dark">@servicio.PrecioReferencial</td>
                                            <td class="text-dark">@servicio.DuracionMinutos</td>
                                            <td class="text-center">
                                                <button type="button" class="btn btn-sm btn-primary px-3 rounded-pill shadow-sm" 
                                                        @onclick="() => SeleccionarServicio(servicio)">
                                                    Seleccionar
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="4" class="text-center py-4 text-muted">
                                            <i class="bi bi-exclamation-triangle me-2"></i>No se encontraron servicios.
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="modal-footer bg-light py-2">
                    <button type="button" class="btn btn-secondary px-4 shadow-sm" @onclick="CerrarModalServicio">Cerrar</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    List<Servicio> listaServicios = new List<Servicio>();
    List<SedeServicio> lisAux = new List<SedeServicio>();
    List<SedeServicioDTO> listaServiciosDTO = new List<SedeServicioDTO>();



    private SedeEditar editarSede = new SedeEditar ();

    private bool cargando = true;
    private bool guardando = false;
    private string? mensajeError;

    // Variables para el control del Modal de Servicios
    private bool mostrarModalServicio = false;
    private string textoBusquedaServicio = "";
    private List<Servicio> todosLosServicios = new();
    private List<Servicio> serviciosFiltrados = new();
    //fin nodales


    protected override async Task OnInitializedAsync()
    {
        try
        {
            // 1. Consultamos la sede existente usando el método que creaste
            var sedeBD = await SedeService.ObtenerSedePorIdAsync(Id);

            listaServiciosDTO = await SedeServicioService.ObtenerServiciosPorSedeAsync(Id);

            if (sedeBD != null)
            {
                // 2. Pasamos los datos de la base de datos al modelo del formulario
                editarSede = new SedeEditar
                {
                    Nombre = sedeBD.Nombre,
                    Direccion = sedeBD.Direccion,
                    Telefono = sedeBD.Telefono,
                    Activo = sedeBD.Activo
                };
            }
            else
            {
                mensajeError = "No se encontró la sede solicitada.";
            }
        }
        catch (Exception)
        {
            mensajeError = "No se pudo cargar la información de la sede.";
        }
        finally
        {
            cargando = false;
        }
    }


    private async Task ActualizarSede()
    {
        cargando = true;
        mensajeError = null;

        try
        {
            Sede sede = new Sede();
            sede.Id = Id;       
            sede.Nombre = editarSede.Nombre;
            sede.Direccion = editarSede.Direccion;
            sede.Telefono = editarSede.Telefono;
            sede.Activo = editarSede.Activo;
            await SedeService.ActualizarSedeAsync(sede);

            // Si todo sale bien y no lanza excepción, redirige a la lista de administración
            Nav.NavigateTo("/sede/administrar");
        }
        catch (Exception ex)
        {
            // Atrapa cualquier error (incluyendo el mensaje que mande el ApiResponse del backend)
            mensajeError = ex.Message;
        }
        finally
        {
            cargando = false;
        }
    }
    

    private void Volver()
    {
        Nav.NavigateTo("/sede/administrar");

    }
     private async Task EliminarSedeServicio(int idSedeServicio)
    {
        await SedeServicioService.EliminarSedeServicioAsync(idSedeServicio);
        listaServiciosDTO = await SedeServicioService.ObtenerServiciosPorSedeAsync(Id);
    }

    // Buscador de Servicios
    private async Task AbrirBuscadorServicio()
    {
        textoBusquedaServicio = "";
        serviciosFiltrados = await SedeServicioService.ObtenerServiciosDisponiblesAsync(Id);

        mostrarModalServicio = true;
    }

    private void CerrarModalServicio()
    {
        mostrarModalServicio = false;
    }

    private async Task SeleccionarServicio(Servicio servicio)
    {
        //nuevaOrden.Servicio = servicio;
        SedeServicio nuevoSedeServicio = new SedeServicio();
        Sede sede= new Sede();
        sede.Id = Id;
        nuevoSedeServicio.Sede = sede;
        nuevoSedeServicio.Servicio = servicio;
        await SedeServicioService.CrearSedeServicioAsync(nuevoSedeServicio);

        serviciosFiltrados = await SedeServicioService.ObtenerServiciosDisponiblesAsync(Id);
        listaServiciosDTO = await SedeServicioService.ObtenerServiciosPorSedeAsync(Id);
        
    }
    private void FiltrarServicios()
    {
        
    }

    public class SedeEditar
    {
    [Required(ErrorMessage = "El nombre de la sede es obligatorio")]
    public string Nombre { get; set; } = string.Empty;

    [Required(ErrorMessage = "La dirección es obligatoria")]
    public string Direccion { get; set; } = string.Empty;

    [Required(ErrorMessage = "El teléfono es obligatorio")]
    [Phone(ErrorMessage = "Ingrese un número de teléfono válido")]
    public string Telefono { get; set; } = string.Empty;

    public bool Activo { get; set; } = true;
    }

}
