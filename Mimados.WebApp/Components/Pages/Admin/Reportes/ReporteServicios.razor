@page "/reporte/servicios"
@using Mimados.WebApp.Models
@using Mimados.WebApp.Services
@inject IReporteService ReporteService
@rendermode InteractiveServer

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Reporte de Servicios Más Solicitados</h2>
        <button class="btn btn-success" @onclick="ExportarPDF">
            <i class="bi bi-file-earmark-pdf"></i> Exportar PDF
        </button>
    </div>

        <!-- Filtros del Reporte -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-info text-white">
            <h5 class="card-title m-0 fw-bold">Filtros de Búsqueda</h5>
        </div>
        <div class="card-body bg-light">
            <!-- Fila 2: Fechas (Desde y Hasta lado a lado) -->
            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label class="form-label fw-bold">Fecha Desde</label>
                    <input type="date" class="form-control" @bind="filtroFechaInicio" />
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-bold">Fecha Hasta</label>
                    <input type="date" class="form-control" @bind="filtroFechaFin" />
                </div>
            </div>

            <!-- Fila 3: Botones de Acción -->
            <div class="row">
                <div class="col-12 d-flex gap-2">
                    <button class="btn btn-primary btn-sm px-4 shadow-sm" @onclick="AplicarFiltros">
                        <i class="bi bi-search me-1"></i>Buscar
                    </button>
                    <button class="btn btn-outline-secondary btn-sm px-4" @onclick="LimpiarFiltros">
                        <i class="bi bi-x-circle me-1"></i>Limpiar
                    </button>
                </div>
            </div>
        </div>
    </div>
    <!-- Mensaje de Error si las fechas no son válidas -->
    @if (fechasNoValidas)
    {
        <div class="alert alert-danger alert-dismissible fade show mt-2" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @mensajeError
            <button type="button" class="btn-close" @onclick="CerrarMensajeError"></button>
        </div>
    }


        <!-- Resultados del Reporte -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-primary text-white">
            <h5 class="card-title m-0 fw-bold">Listado de Servicios Encontrados</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped table-bordered align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th>#</th>
                            <th>Nombre del Servicio</th>
                            <th>Total Solicitudes</th>
                            <th>Precio Unitario</th>
                            <th>Ingresos Totales</th>
                            <th>Estado</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (serviciosPopulares.Count == 0)
                        {
                            <tr>
                                <td colspan="7" class="text-center text-muted py-4">No se encontraron servicios registrados para el período seleccionado.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var c in serviciosPopulares)
                            {
                                <tr>
                                    <td>@c.Orden</td>
                                    <td>@c.Nombre</td>
                                    <td>@c.Cantidad</td>
                                    <td>@c.Precio.ToString("N2")</td>
                                    <td>@c.Total.ToString("N2")</td>
                                    <td>@c.Proporcion</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@code {
    private DateOnly? filtroFechaInicio;
    private DateOnly? filtroFechaFin;
    private string filtroSede = "";

    private string mensajeError = "";
    private bool fechasNoValidas = false;

    private bool ValidarFechas()
    {
        if (filtroFechaInicio.HasValue && filtroFechaFin.HasValue)
        {
            if (filtroFechaInicio >= filtroFechaFin)
            {
                mensajeError = "La fecha de inicio debe ser anterior a la fecha de fin.";
                fechasNoValidas = true;
                return false;
            }
        }
        fechasNoValidas = false;
        return true;
    }
    private void CerrarMensajeError()
    {
        fechasNoValidas = false;
        mensajeError = string.Empty;
    }
    private async Task AplicarFiltros()
    {
        if (!ValidarFechas())
        {
            Console.WriteLine("entro a error de fechas");

            return;
        }

        try
        {
            serviciosPopulares=await ReporteService.ObtenerReporteServiciosPorFechas(filtroFechaInicio, filtroFechaFin);
            Console.WriteLine("Filtrando Ando");
        }
        catch (Exception ex)
        {
            Console.WriteLine("atrapo algo");

            mensajeError = "Error al obtener los servicios: " + ex.Message;
            // Manejo de errores
        }
        
    }

    private void LimpiarFiltros()
    {
        filtroFechaInicio = null;
        filtroFechaFin = null;
        filtroSede = "";//pruebas
    }

    private class ServicioReporte
    {
        public string Nombre { get; set; } = "";
        public double Precio { get; set; } = 0.0;
        public int Cantidad { get; set; }
        public double Ingreso { get; set; } = 0.0;
    }

    private List<ReporteServiciosDTO> serviciosPopulares = new();

    private void ExportarPDF()
    {
        Console.WriteLine("Exportando Ando");
    }
}
