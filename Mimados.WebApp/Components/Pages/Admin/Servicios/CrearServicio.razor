@page "/servicio/crear"
@using Mimados.WebApp.Models
@rendermode InteractiveServer
@inject NavigationManager Nav
@inject IServicioService ServicioService
@using System.ComponentModel.DataAnnotations

<div class="container-fluid mt-4">
    
    @* Cabecera con botón para retroceder *@
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Registrar Nuevo Servicio</h2>
        <button class="btn btn-secondary" @onclick="Volver">
            <i class="bi bi-arrow-left"></i> Volver 
        </button>
    </div>

    <div class="card p-4 shadow-sm border-0 bg-white">
        <EditForm Model="@nuevoServicio" OnValidSubmit="GuardarServicio">
            <DataAnnotationsValidator />

            <div class="mb-3">
                <label class="form-label fw-bold">Nombre del servicio:</label>
                <InputText @bind-Value="nuevoServicio.Nombre" class="form-control" placeholder="Ej. Servicio ..." />
                <ValidationMessage For="@(() => nuevoServicio.Nombre)" class="text-danger small" />
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Descripcion:</label>
                    <InputText @bind-Value="nuevoServicio.Descripcion" class="form-control" placeholder="Ej. Deteccion ..." />
                    <ValidationMessage For="@(() => nuevoServicio.Descripcion)" class="text-danger small" />
            </div>

            <div class="row">
                
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">Precio referencial:</label>
                    <InputNumber @bind-Value="nuevoServicio.PrecioReferencial" class="form-control" step="0.01"  />
                    <ValidationMessage For="@(() => nuevoServicio.PrecioReferencial)" class="text-danger small" />

                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">Duracion en minutos:</label>
                    <InputNumber @bind-Value="nuevoServicio.DuracionMinutos" class="form-control" step="1"  />
                    <ValidationMessage For="@(() => nuevoServicio.DuracionMinutos)" class="text-danger small" />
                </div>
            </div>

            

            

            <div class="text-end">
                <button type="submit" class="btn btn-primary px-4 fw-bold" >
                    <i class="bi bi-save"></i> Guardar Servicio

                </button>
            </div>
        </EditForm>
    </div>
</div>

@code {
    // Inicializamos con la fecha de hoy por defecto
    private ServicioRegistroModel nuevoServicio = new ServicioRegistroModel ();

    private bool cargando = false;
    private string? mensajeError;

    /*private void GuardarServicio()
    {
        // Aquí simulamos que se guarda en la Base de Datos.
        // Más adelante, aquí usarás HttpClient para hacer el POST al servidor.
        
        // Redirigimos al usuario de regreso a su grilla usando NavigationManager[cite: 5]
        Nav.NavigateTo("/servicio/administrar");
    }*/


    private async Task GuardarServicio()
    {
        cargando = true;
        mensajeError = null;

        try
        {
            Servicio se = new Servicio();
            se.Nombre = nuevoServicio.Nombre;
            se.Descripcion = nuevoServicio.Descripcion;
            se.PrecioReferencial = (double)nuevoServicio.PrecioReferencial;
            se.DuracionMinutos = nuevoServicio.DuracionMinutos;


            bool exito = await ServicioService.CrearServicioAsync(se);

            if (exito)
            {
                // Si se registró con éxito, redirigimos al usuario a la lista de sedes
                Nav.NavigateTo("/servicio/administrar");
            }
            else
            {
                mensajeError = "No se pudo registrar el servicio. Verifica los datos.";
            }
        }
        catch (Exception)
        {
            mensajeError = "No se pudo registrar el servicio. Inténtalo nuevamente.";
        }
        finally
        {
            cargando = false;
        }
    }

    private void Volver()
    {
        Nav.NavigateTo("/servicio/administrar");
    }

    // Modelo de datos exclusivo para crear servicioos
    public class ServicioRegistroModel
{
    [Required(ErrorMessage = "El nombre del servicio es obligatorio")]
    public string Nombre { get; set; } = string.Empty;

    [Required(ErrorMessage = "La descripción es obligatoria")]
    public string Descripcion { get; set; } = string.Empty;

    [Range(0.00, 9999.99, ErrorMessage = "Ingrese un precio referencial válido")]
    public decimal PrecioReferencial { get; set; }

    [Range(1, 1440, ErrorMessage = "Ingrese una duración válida en minutos")]
    public int DuracionMinutos { get; set; }


    

}
}
