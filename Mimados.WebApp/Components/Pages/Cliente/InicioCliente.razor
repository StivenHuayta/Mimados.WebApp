@page "/cliente/inicio"
@rendermode InteractiveServer

<PageTitle>Inicio - Clínica Veterinaria Mimados</PageTitle>

<div class="container-fluid py-2">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-5">
        <div>
            <h4 class="fw-bold text-dark mb-1">Hola @NombreUsuario</h4>
            <p class="text-muted mb-0">Esta es tu próxima cita:</p>
        </div>
        <a href="/cliente/citas" class="text-decoration-underline text-dark fw-medium small">
            Ver todas las citas
        </a>
    </div>

    <div class="d-flex flex-column align-items-center justify-content-center text-center py-5 my-4">
        <div class="mb-3 text-primary" style="font-size: 3.5rem; line-height: 1;">
            <i class="bi bi-calendar2-check"></i>
        </div>
        <h5 class="fw-bold text-dark mb-2">Aún no has agendado una cita</h5>
        <p class="text-muted mb-4" style="max-width: 360px;">
            Programa tu cita ahora y recibe atención a tiempo.
        </p>
        <a href="/cliente/citas/nueva" class="btn btn-primary rounded-pill px-5 py-2 fw-semibold shadow-sm">
            Agendar cita
        </a>
    </div>
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private string NombreUsuario { get; set; } = "Cliente";

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask != null)
        {
            var authState = await AuthStateTask;
            var displayName = authState.User.FindFirst("DisplayName")?.Value;
            if (!string.IsNullOrWhiteSpace(displayName))
            {
                NombreUsuario = displayName;
            }
        }
    }
}
