@page "/cliente/perfil"
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@inject NavigationManager Nav

@inject IUsuarioService UsuarioService

<div class="container mt-4" style="max-width: 800px;">
    
    @* Cabecera con botón destructivo *@
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Mi Perfil</h2>
        <button class="btn btn-outline-danger" @onclick="MostrarModalEliminar">
            <i class="bi bi-trash"></i> Eliminar Cuenta
        </button>
    </div>

    @* Alerta de Éxito Simulada *@
    @if (mostrarAlertaGuardado)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> Tus datos han sido actualizados correctamente.
            <button type="button" class="btn-close" @onclick="() => mostrarAlertaGuardado = false"></button>
        </div>
    }

    @if (mostrarAlertaError)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @(mensajeAlerta ?? "Hubo un problema al actualizar tu perfil. Inténtalo más tarde.")
            <button type="button" class="btn-close" @onclick="() => mostrarAlertaError = false"></button>
        </div>
    }

    <div class="card p-4 shadow-sm border-0">
        
        @* Formulario de Edición con DataAnnotationsValidator *@
        <EditForm Model="@perfilCliente" OnValidSubmit="GuardarCambios">
            <DataAnnotationsValidator />

            <div class="row">
                @* Campos de solo lectura (Llaves principales / Usuario) *@
                <div class="col-md-6 mb-3">
                    <label class="form-label text-muted">DNI (No modificable):</label>
                    <InputText @bind-Value="perfilCliente.Dni" class="form-control" disabled />
                </div>
                
                <div class="col-md-6 mb-3">
                    <label class="form-label text-muted">Correo electrónico (No modificable):</label>
                    <InputText @bind-Value="perfilCliente.Email" class="form-control" disabled />
                </div>

                @* Campos Editables *@
                <div class="col-md-6 mb-3">
                    <label class="form-label">Nombres:</label>
                    <InputText @bind-Value="perfilCliente.Nombres" class="form-control" />
                    <ValidationMessage For="@(() => perfilCliente.Nombres)" class="text-danger small" />
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label">Apellidos:</label>
                    <InputText @bind-Value="perfilCliente.Apellidos" class="form-control" />
                    <ValidationMessage For="@(() => perfilCliente.Apellidos)" class="text-danger small" />
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label">Teléfono:</label>
                    <InputText @bind-Value="perfilCliente.Telefono" class="form-control" />
                    <ValidationMessage For="@(() => perfilCliente.Telefono)" class="text-danger small" />
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label">Contacto de Emergencia:</label>
                    <InputText @bind-Value="perfilCliente.ContactoEmergencia" class="form-control" />
                    <ValidationMessage For="@(() => perfilCliente.ContactoEmergencia)" class="text-danger small" />
                </div>

                <div class="col-12 mb-4">
                    <label class="form-label">Dirección:</label>
                    <InputText @bind-Value="perfilCliente.Direccion" class="form-control" />
                    <ValidationMessage For="@(() => perfilCliente.Direccion)" class="text-danger small" />
                </div>
            </div>

            <div class="text-end">
                <button type="submit" class="btn btn-primary px-4">Guardar Cambios</button>
            </div>
        </EditForm>
    </div>
    
    @* Modal de Confirmación Nativo (Sin JS) *@
    @if (mostrarModal)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header bg-danger text-white">
                        <h5 class="modal-title">¿Eliminar cuenta?</h5>
                        <button type="button" class="btn-close btn-close-white" @onclick="OcultarModal"></button>
                    </div>
                    <div class="modal-body">
                        <p>¿Estás seguro de que deseas dar de baja tu cuenta? Esta acción no se puede deshacer y perderás el acceso al sistema.</p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="OcultarModal">Cancelar</button>
                        <button type="button" class="btn btn-danger" @onclick="ConfirmarEliminacion">Sí, eliminar definitivamente</button>
                    </div>
                </div>
            </div>
        </div>
    }

</div>





@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationStateTask { get; set; } = default!;

    // Instancia que se unirá al formulario HTML
    private Mimados.WebApp.Models.UsuarioPerfilModel perfilCliente = new();
    
    private bool mostrarAlertaGuardado = false;
    private bool mostrarAlertaError = false;
    private bool mostrarModal = false;
    private int idUsuarioLogueado = 0;
    private string? mensajeAlerta;

    
    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateTask;
        var user = authState.User;

        if (user.Identity is not null && user.Identity.IsAuthenticated)
        {
            var claimId = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value 
                          ?? user.FindFirst("UsuarioId")?.Value;

            if (int.TryParse(claimId, out idUsuarioLogueado))
            {
                // Obtenemos el perfil real desde Java
                var data = await UsuarioService.ObtenerPerfilAsync(idUsuarioLogueado);
                if (data != null)
                {
                    perfilCliente = data;
                }
            }
        }
    }

    private async Task GuardarCambios()
    {
        mostrarAlertaGuardado = false;
        mostrarAlertaError = false;

        // Validamos que exista un ID válido de sesión antes de enviar
        if (idUsuarioLogueado > 0)
        {
            // Opcional: asegurarnos de que el ID del modelo sea el del usuario logueado
            perfilCliente.Id = idUsuarioLogueado; 
            
            bool exito = await UsuarioService.ActualizarPerfilAsync(perfilCliente);
            if (exito)
            {
                mostrarAlertaGuardado = true;
            }
            else
            {
                mostrarAlertaError = true;
            }
        }
    }

    // Métodos para controlar el Modal
    private void MostrarModalEliminar() => mostrarModal = true;
    private void OcultarModal() => mostrarModal = false;

    private  async Task ConfirmarEliminacion()
    {
        if (idUsuarioLogueado > 0)
        {
            // Descomenta esta línea cuando agregues el método Eliminar en tu IUsuarioService
             bool exito = await UsuarioService.EliminarCuentaLogicaAsync(idUsuarioLogueado);
            
            // Si tiene éxito, cerramos su sesión y lo mandamos al login
            if (exito) {
                Nav.NavigateTo("/auth/logout", forceLoad: true); 
             }
             else
            {
                OcultarModal();
                mostrarAlertaError = true;
                mensajeAlerta = "No se pudo eliminar la cuenta. Inténtalo más tarde."; // (Si agregaste el string mensajeAlerta)
            }
        }
    }

    
}