@page "/cliente/mascotas"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject NavigationManager Nav

@using Mimados.WebApp.Models
@inject IMascotaService MascotaService

<div class="container mt-4">
    @* Cabecera con título y botones de acción *@
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <div>
            <h2 class="mb-0">@(viendoDadasDeBaja ? "Mascotas dadas de baja" : "Mis Mascotas")</h2>
        </div>
        <div class="d-flex flex-wrap align-items-center gap-2">
            <button type="button"
                    class="btn @(viendoDadasDeBaja ? "btn-outline-primary" : "btn-outline-secondary")"
                    @onclick="AlternarVistaDadasDeBaja">
                @if (viendoDadasDeBaja)
                {
                    <i class="bi bi-arrow-left me-1"></i>
                    <span>Ver mascotas activas (@MascotasActivas.Count)</span>
                }
                else
                {
                    <i class="bi bi-archive me-1"></i>
                    <span>Dadas de baja (@MascotasInactivas.Count)</span>
                }
            </button>

            @if (!viendoDadasDeBaja)
            {
                <button class="btn btn-primary" @onclick="IrANuevaMascota">
                    + Registrar Nueva Mascota
                </button>
            }
        </div>
    </div>

    @* Grilla de Tarjetas usando Bootstrap *@
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @if (listaMascotas == null)
        {
            <div class="col-12">
                <div class="alert alert-info">Cargando tus mascotas...</div>
            </div>
        }
        else if (!MascotasVisibles.Any())
        {
            <div class="col-12">
                <div class="alert @(viendoDadasDeBaja ? "alert-info" : "alert-warning")">
                    @(viendoDadasDeBaja
                        ? "No tienes mascotas dadas de baja."
                        : "Aún no tienes mascotas activas registradas.")
                </div>
            </div>
        }
        else
        {
            @foreach (var mascota in MascotasVisibles)
            {
                bool tieneAtenciones = mascotasConAtenciones.Contains(mascota.MascotaId);
                bool menuAbierto = menuAbiertoMascotaId == mascota.MascotaId;

                <div class="col">
                    <div class="card h-100 shadow-sm bg-white mascota-card" @onclick="() => IrAHistorial(mascota.MascotaId)">
                        <div class="card-header @(mascota.Activo ? "bg-primary text-white" : "bg-secondary bg-opacity-10 text-dark") d-flex justify-content-between align-items-center gap-2 px-3 py-3">
                            <h5 class="mb-0 fw-bold @(mascota.Activo ? "text-white" : "text-dark") text-truncate">
                                @mascota.Nombre
                            </h5>
                            <div class="d-flex align-items-center gap-2 ms-auto flex-shrink-0" @onclick:stopPropagation="true">
                                <span class="badge @(mascota.Activo ? "bg-white text-primary" : "badge-mimados-neutral")">@mascota.Especie</span>

                                @if (mascota.Activo)
                                {
                                    <div class="dropdown position-relative d-inline-flex align-items-center">
                                        <button type="button"
                                                class="btn-card-menu"
                                                aria-label="Opciones de @mascota.Nombre"
                                                @onclick="() => AlternarMenu(mascota.MascotaId)">
                                            <i class="bi bi-three-dots-vertical fs-5"></i>
                                        </button>

                                        @if (menuAbierto)
                                        {
                                            <ul class="dropdown-menu dropdown-menu-end show shadow-sm" style="position: absolute; right: 0; top: 100%; z-index: 1050;">
                                                <li>
                                                    <button type="button" class="dropdown-item" @onclick="() => EditarDesdeMenu(mascota.MascotaId)">
                                                        <i class="bi bi-pencil me-2 text-primary"></i>Editar
                                                    </button>
                                                </li>
                                                <li><hr class="dropdown-divider" /></li>
                                                <li>
                                                    @if (tieneAtenciones)
                                                    {
                                                        <span class="dropdown-item text-muted disabled" title="No se puede dar de baja porque tiene atenciones registradas">
                                                            <i class="bi bi-lock me-2"></i>Dar de baja (con atenciones)
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <button type="button" class="dropdown-item text-danger" @onclick="() => SolicitarBajaDesdeMenu(mascota)">
                                                            <i class="bi bi-archive me-2"></i>Dar de baja
                                                        </button>
                                                    }
                                                </li>
                                            </ul>
                                        }
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="card-body d-flex flex-column">
                            <p class="mb-1"><strong>Raza:</strong> @(string.IsNullOrWhiteSpace(mascota.Raza) ? "No registrada" : mascota.Raza)</p>
                            <p class="mb-1"><strong>Sexo:</strong> @mascota.Sexo</p>
                            @if (mascota.Activo)
                            {
                                <p class="mb-1">
                                    <strong>Edad:</strong> @FormatearEdad(mascota.FechaNacimiento)
                                    @if (mascota.FechaNacimiento.HasValue)
                                    {
                                        <span class="text-muted small ms-1">(@mascota.FechaNacimiento.Value.ToString("dd/MM/yyyy"))</span>
                                    }
                                </p>
                            }
                            <p class="mb-3"><strong>Último peso:</strong> @(mascota.PesoReferencial.HasValue ? $"{mascota.PesoReferencial.Value:0.0} kg" : "No registrado")</p>

                            <div class="mt-auto d-grid">
                                <button type="button"
                                        class="btn @(mascota.Activo ? "btn-primary" : "btn-outline-primary") btn-sm fw-semibold"
                                        @onclick:stopPropagation="true"
                                        @onclick="() => IrAHistorial(mascota.MascotaId)">
                                    <i class="bi bi-journal-medical me-1"></i> Ver Ficha / Historial
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </div>

    @if (mostrarModalBaja && mascotaADarDeBaja != null)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content border-0 shadow-lg">
                    <div class="modal-header bg-primary text-white">
                        <h5 class="modal-title fw-bold text-white">
                            <i class="bi bi-exclamation-circle-fill me-2"></i>¿Dar de baja a @mascotaADarDeBaja.Nombre?
                        </h5>
                        <button type="button" class="btn-close btn-close-white" aria-label="Cerrar" @onclick="CancelarBaja" disabled="@procesandoBaja"></button>
                    </div>
                    <div class="modal-body p-4">
                        <p class="mb-2">
                            Estás a punto de dar de baja a <strong>@mascotaADarDeBaja.Nombre</strong> (@mascotaADarDeBaja.Especie).
                        </p>
                        <div class="alert alert-warning small mb-0">
                            <i class="bi bi-info-circle-fill me-1"></i>
                            <strong>Aviso:</strong> Ya no se le podrán sacar nuevas citas y pasará al apartado de <strong>Mascotas dadas de baja</strong>.
                        </div>
                    </div>
                    <div class="modal-footer bg-white">
                        <button type="button" class="btn btn-secondary" @onclick="CancelarBaja" disabled="@procesandoBaja">Cancelar</button>
                        <button type="button" class="btn btn-danger fw-semibold" @onclick="ConfirmarBaja" disabled="@procesandoBaja">
                            @(procesandoBaja ? "Procesando..." : "Sí, dar de baja")
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationStateTask { get; set; } = default!;

    private List<Mimados.WebApp.Models.Mascota>? listaMascotas;
    private HashSet<int> mascotasConAtenciones = new();
    private int idClienteLogueado = 0;

    private bool viendoDadasDeBaja = false;
    private int? menuAbiertoMascotaId;
    private Mimados.WebApp.Models.Mascota? mascotaADarDeBaja;
    private bool mostrarModalBaja = false;
    private bool procesandoBaja = false;

    private List<Mimados.WebApp.Models.Mascota> MascotasActivas =>
        listaMascotas?.Where(m => m.Activo).ToList() ?? new();

    private List<Mimados.WebApp.Models.Mascota> MascotasInactivas =>
        listaMascotas?.Where(m => !m.Activo).ToList() ?? new();

    private List<Mimados.WebApp.Models.Mascota> MascotasVisibles =>
        viendoDadasDeBaja ? MascotasInactivas : MascotasActivas;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateTask;
        var user = authState.User;

        if (user.Identity is not null && user.Identity.IsAuthenticated)
        {
            var claimId = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value
                          ?? user.FindFirst("UsuarioId")?.Value;

            if (int.TryParse(claimId, out int clienteId))
            {
                idClienteLogueado = clienteId;
                listaMascotas = await MascotaService.ObtenerMascotasPorClienteAsync(idClienteLogueado);
                await CargarAtencionesPorMascotaAsync();
            }
            else
            {
                listaMascotas = new List<Mimados.WebApp.Models.Mascota>();
            }
        }
        else
        {
            listaMascotas = new List<Mimados.WebApp.Models.Mascota>();
        }
    }

    private async Task CargarAtencionesPorMascotaAsync()
    {
        mascotasConAtenciones.Clear();
        if (listaMascotas == null || listaMascotas.Count == 0) return;

        var tareas = listaMascotas.Select(async m =>
        {
            var historial = await MascotaService.ObtenerHistorialAsync(m.MascotaId);
            return (m.MascotaId, TieneAtenciones: historial.Count > 0);
        });

        var resultados = await Task.WhenAll(tareas);
        foreach (var item in resultados)
        {
            if (item.TieneAtenciones)
            {
                mascotasConAtenciones.Add(item.MascotaId);
            }
        }
    }

    private void AlternarVistaDadasDeBaja()
    {
        menuAbiertoMascotaId = null;
        viendoDadasDeBaja = !viendoDadasDeBaja;
    }

    private static string FormatearEdad(DateTime? fechaNacimiento)
    {
        if (!fechaNacimiento.HasValue)
            return "No registrado";

        var nacimiento = fechaNacimiento.Value.Date;
        var hoy = DateTime.Today;

        if (nacimiento > hoy)
            return "No registrado";

        int anios = hoy.Year - nacimiento.Year;
        int meses = hoy.Month - nacimiento.Month;
        int dias = hoy.Day - nacimiento.Day;

        if (dias < 0)
        {
            meses--;
            var mesAnterior = hoy.AddMonths(-1);
            dias += DateTime.DaysInMonth(mesAnterior.Year, mesAnterior.Month);
        }

        if (meses < 0)
        {
            anios--;
            meses += 12;
        }

        if (anios > 0)
        {
            string textoAnios = $"{anios} {(anios == 1 ? "año" : "años")}";
            return meses > 0
                ? $"{textoAnios} y {meses} {(meses == 1 ? "mes" : "meses")}"
                : textoAnios;
        }

        if (meses > 0)
        {
            return $"{meses} {(meses == 1 ? "mes" : "meses")}";
        }

        if (dias == 0)
            return "Recién nacido";

        return $"{dias} {(dias == 1 ? "día" : "días")} de nacido";
    }

    private void AlternarMenu(int mascotaId)
    {
        menuAbiertoMascotaId = menuAbiertoMascotaId == mascotaId ? null : mascotaId;
    }

    private void EditarDesdeMenu(int id)
    {
        menuAbiertoMascotaId = null;
        IrAEditarMascota(id);
    }

    private void SolicitarBajaDesdeMenu(Mimados.WebApp.Models.Mascota mascota)
    {
        menuAbiertoMascotaId = null;
        if (mascotasConAtenciones.Contains(mascota.MascotaId)) return;
        mascotaADarDeBaja = mascota;
        mostrarModalBaja = true;
    }

    private void CancelarBaja()
    {
        if (procesandoBaja) return;
        mostrarModalBaja = false;
        mascotaADarDeBaja = null;
    }

    private async Task ConfirmarBaja()
    {
        if (mascotaADarDeBaja == null || procesandoBaja) return;

        procesandoBaja = true;
        int id = mascotaADarDeBaja.MascotaId;

        try
        {
            bool exito = await MascotaService.EliminarMascotaAsync(id);
            if (exito)
            {
                mascotaADarDeBaja.Activo = false;
            }
            else if (idClienteLogueado > 0)
            {
                listaMascotas = await MascotaService.ObtenerMascotasPorClienteAsync(idClienteLogueado);
                await CargarAtencionesPorMascotaAsync();
            }
        }
        finally
        {
            procesandoBaja = false;
            mostrarModalBaja = false;
            mascotaADarDeBaja = null;
        }
    }

    public void IrANuevaMascota()
    {
        Nav.NavigateTo("/cliente/mascotas/nueva");
    }

    public void IrAEditarMascota(int id)
    {
        Nav.NavigateTo($"/cliente/mascotas/editar/{id}");
    }

    private void IrAHistorial(int id)
    {
        menuAbiertoMascotaId = null;
        Nav.NavigateTo($"/cliente/mascotas/{id}/historial");
    }
}
