@page "/cliente/mascotas"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject NavigationManager Nav

@using Mimados.WebApp.Models
@inject IMascotaService MascotaService


<div class="container mt-4">
    
    @* Cabecera con título y botón de acción principal *@
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Mis Mascotas</h2>
        <button class="btn btn-primary" @onclick="IrANuevaMascota">
            + Registrar Nueva Mascota
        </button>
    </div>

    @* Grilla de Tarjetas usando Bootstrap *@
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        
    
        @if (listaMascotas == null)
        {
            <div class="col-12">
                <div class="alert alert-info">Cargando tus mascotas...</div>
            </div>
        }
        else if (!listaMascotas.Any())
        {
            <div class="col-12">
                <div class="alert alert-warning">Aún no tienes mascotas registradas.</div>
            </div>
        }
        else
        {
            @foreach (var mascota in listaMascotas)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm border-0 bg-white">
                        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                           
                            <h5 class="mb-0 fw-bold text-white">
                                @mascota.Nombre
                                
                               @if (!mascota.Activo)
                                {
                                  <span class="badge badge-mimados-danger ms-2" style="font-size: 0.6em;">Inactivo</span>
                                }
                            
                            
                            </h5>


                            <span class="badge bg-white text-primary">@mascota.Especie</span>
                        </div>
                        <div class="card-body">
                            <p class="mb-1"><strong>Raza:</strong> @mascota.Raza</p>
                            <p class="mb-1"><strong>Sexo:</strong> @mascota.Sexo</p>
                            <p class="mb-1"><strong>Nacimiento:</strong> @(mascota.FechaNacimiento?.ToString("dd/MM/yyyy") ?? "No registrado")</p>
                            <p class="mb-3"><strong>Peso ref:</strong> @mascota.PesoReferencial kg</p>
                            
                            <div class="d-grid gap-2">
                                <button class="btn btn-outline-primary btn-sm fw-semibold" @onclick="() => IrAHistorial(mascota.MascotaId)">
                                    <i class="bi bi-journal-medical me-1"></i> Ver Historial
                                </button>
                            </div>
                        </div>
                        <div class="card-footer bg-white border-top d-flex justify-content-between py-2">
                            <button class="btn btn-outline-secondary btn-sm fw-semibold" @onclick="() => IrAEditarMascota(mascota.MascotaId)">
                                Editar
                            </button>
                            @* Agregamos el evento onclick para ejecutar el método de eliminar *@
                            <button class="btn btn-outline-danger btn-sm fw-semibold" @onclick="() => EliminarMascota(mascota.MascotaId)">
                                Eliminar
                            </button>
                        </div>
                    </div>
                </div>
            }
        }
       

    </div>
</div>


@code{

    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationStateTask { get; set; } = default!;
    private List<Mimados.WebApp.Models.Mascota>? listaMascotas;
    private int idClienteLogueado = 0; // Variable para almacenar el ID del cliente logueado

        protected override async Task OnInitializedAsync()
    {

        var authState = await AuthenticationStateTask;
        var user = authState.User;


        if (user.Identity is not null && user.Identity.IsAuthenticated)
        {
            // 3. Buscamos el claim que contiene el ID.
            // Usualmente .NET lo guarda como NameIdentifier o lo puedes haber llamado "UsuarioId"
            var claimId = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value
                          ?? user.FindFirst("UsuarioId")?.Value;

            if (int.TryParse(claimId, out int clienteId))
            {
                idClienteLogueado = clienteId;
                // 4. Ejecutamos tu servicio con el ID dinámico
                listaMascotas = await MascotaService.ObtenerMascotasPorClienteAsync(idClienteLogueado);
            }
            else
            {
                // Si por alguna razón el ID del claim no es numérico, devolvemos lista vacía
                listaMascotas = new List<Mimados.WebApp.Models.Mascota>();
            }
        }
        else
        {
            // Opcional: Si no está logueado, podrías usar Nav.NavigateTo("/login")
            listaMascotas = new List<Mimados.WebApp.Models.Mascota>();
        }
    }


    private async Task EliminarMascota(int id)
    {
        // 1. ACTUALIZACIÓN OPTIMISTA: Borramos la mascota de la vista inmediatamente
        var mascotaAEliminar = listaMascotas?.FirstOrDefault(m => m.MascotaId == id);
        if (mascotaAEliminar != null)
        {
            listaMascotas!.Remove(mascotaAEliminar);
        }

        // 2. Enviamos la orden de eliminación a Java/MySQL en segundo plano
        bool exito = await MascotaService.EliminarMascotaAsync(id);

        // 3. Manejo de fallos: Si la API diera un error (ej. se cae el internet),
        // volvemos a descargar la lista real para corregir la pantalla.
        if (!exito && idClienteLogueado > 0)
        {
            
            listaMascotas = await MascotaService.ObtenerMascotasPorClienteAsync(idClienteLogueado);
        }
    }


public void IrANuevaMascota()
    {
        Nav.NavigateTo("/cliente/mascotas/nueva");
    }
    public void IrAEditarMascota(int id)
    {
        Nav.NavigateTo($"/cliente/mascotas/editar/{id}");

    }


    private void IrAHistorial(int id)
    {
        Nav.NavigateTo($"/cliente/mascotas/{id}/historial");
    }


}