@page "/cliente/mascotas/nueva"
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@* Inyectamos el NavigationManager para poder regresar a la grilla[cite: 5] *@
@inject NavigationManager Nav

@* INICIO CAMBIOS: Importar modelo e inyectar el servicio *@
@using Mimados.WebApp.Models
@inject IMascotaService MascotaService
@* FIN CAMBIOS *@







<div class="container mt-4" style="max-width: 600px;">
    
    @* Cabecera con botón para retroceder *@
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Registrar Nueva Mascota</h2>
        <button class="btn btn-secondary" @onclick="Volver">
            <i class="bi bi-arrow-left"></i> Volver a Mis Mascotas
        </button>
    </div>

    @* INICIO CAMBIOS: Mensaje de error *@
    @if (!string.IsNullOrEmpty(mensajeError))
    {
        <div class="alert alert-danger">@mensajeError</div>
    }
    @* FIN CAMBIOS *@



    <div class="card p-4 shadow-sm border-0 bg-white">
        <EditForm Model="@nuevaMascota" OnValidSubmit="GuardarMascota">
            <DataAnnotationsValidator />

            <div class="mb-3">
                <label class="form-label fw-bold">Nombre de la Mascota:</label>
                <InputText @bind-Value="nuevaMascota.Nombre" class="form-control" placeholder="Ej. Firulais" />
                <ValidationMessage For="@(() => nuevaMascota.Nombre)" class="text-danger small" />
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">Especie:</label>
                    <InputSelect @bind-Value="nuevaMascota.Especie" class="form-select">
                        <option value="">-- Seleccione --</option>

                        <option value="CANINO">Perro</option>
                        <option value="FELINO">Gato</option>
                        <option value="CONEJO">Conejo</option>
                        <option value="AVE">Ave</option>
                        <option value="OTRO">Otro</option>

                    </InputSelect>
                    <ValidationMessage For="@(() => nuevaMascota.Especie)" class="text-danger small" />
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">Raza (Opcional):</label>
                    <InputText @bind-Value="nuevaMascota.Raza" class="form-control" placeholder="Ej. Bulldog, Siamés" />
                </div>
            </div>




            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">Sexo:</label>
                    <InputSelect @bind-Value="nuevaMascota.Sexo" class="form-select">
                        <option value="">-- Seleccione --</option>
                     <option value="MACHO">Macho</option>
                        <option value="HEMBRA">Hembra</option>
                    </InputSelect>
                    <ValidationMessage For="@(() => nuevaMascota.Sexo)" class="text-danger small" />
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">Fecha de Nacimiento:</label>
                    @* InputDate abre el calendario nativo del navegador *@
                    <InputDate @bind-Value="nuevaMascota.FechaNacimiento" class="form-control" />
                    <ValidationMessage For="@(() => nuevaMascota.FechaNacimiento)" class="text-danger small" />
                </div>
            </div>

            <div class="mb-4">
                <label class="form-label fw-bold">Peso Referencial (kg):</label>
                @* InputNumber restringe el ingreso solo a valores numéricos *@
                <InputNumber @bind-Value="nuevaMascota.PesoReferencial" class="form-control" step="0.1" />
                <ValidationMessage For="@(() => nuevaMascota.PesoReferencial)" class="text-danger small" />
            </div>

            <div class="text-end">
                <button type="submit" class="btn btn-primary px-4 fw-bold">
                    <i class="bi bi-save"></i> Guardar Mascota
                </button>
            </div>
        </EditForm>
    </div>
</div>

@code {


    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationStateTask { get; set; } = default!;
    // Inicializamos con la fecha de hoy por defecto
    private MascotaRegistroModel nuevaMascota = new MascotaRegistroModel { FechaNacimiento = DateTime.Today };

    private string? mensajeError;



    private async Task GuardarMascota()
    {
        mensajeError = null;

        var authState = await AuthenticationStateTask;
        var user = authState.User;
        int idClienteLogueado = 0;

        if (user.Identity is not null && user.Identity.IsAuthenticated)
        {
            var claimId = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value 
                          ?? user.FindFirst("UsuarioId")?.Value;
                          
            int.TryParse(claimId, out idClienteLogueado);
        }

        if (idClienteLogueado == 0)
        {
            mensajeError = "No se pudo identificar tu sesión. Por favor, vuelve a iniciar sesión.";
            return;
        }

        // Construimos la mascota que enviaremos al backend
        var mascotaAGuardar = new Mascota
        {
            Nombre = nuevaMascota.Nombre,
            Especie = nuevaMascota.Especie,
            Raza = nuevaMascota.Raza,
            Sexo = nuevaMascota.Sexo,
            FechaNacimiento = nuevaMascota.FechaNacimiento,
            PesoReferencial = nuevaMascota.PesoReferencial,
            Activo = true,
          //ID FORZADO
            ClienteId = idClienteLogueado
        };

        // Hacemos el POST usando nuestro servicio
        bool exito = await MascotaService.CrearMascotaAsync(mascotaAGuardar);

        if (exito)
        {
            // Redirigimos al usuario de regreso a su grilla
            Nav.NavigateTo("/cliente/mascotas");
        }
        else
        {
            mensajeError = "No se pudo registrar la mascota. Verifica que los datos sean correctos o intentalo más tarde.";
        }
    }

    private void Volver()
    {
        Nav.NavigateTo("/cliente/mascotas");
    }

    // Modelo de datos exclusivo para crear mascotas
    public class MascotaRegistroModel
    {
        [Required(ErrorMessage = "El nombre es obligatorio")]
        public string Nombre { get; set; } = string.Empty;

        [Required(ErrorMessage = "Seleccione una especie")]
        public string Especie { get; set; } = string.Empty;

        public string Raza { get; set; } = string.Empty;

        [Required(ErrorMessage = "Seleccione el sexo")]
        public string Sexo { get; set; } = string.Empty;

        [Required(ErrorMessage = "La fecha es obligatoria")]
        public DateTime FechaNacimiento { get; set; }

        [Range(0.1, 150.0, ErrorMessage = "Ingrese un peso válido en kg")]
        public decimal PesoReferencial { get; set; }
    }
}