@page "/cliente/mascotas/{Id:int}/historial"
@rendermode InteractiveServer
@inject NavigationManager Nav

@using Mimados.WebApp.Models
@using Microsoft.JSInterop

@inject IMascotaService MascotaService
@inject IJSRuntime JS


<div class="container mt-4" style="max-width: 900px;">
    
    @* Cabecera con título dinámico y botones de acción *@
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Historial Clínico: <span class="text-primary">@nombreMascota</span></h2>
        <div>
            <button class="btn btn-secondary me-2" @onclick="Volver">
                <i class="bi bi-arrow-left"></i> Volver
            </button>
            <button class="btn btn-primary" @onclick="ImprimirReporte" disabled="@generandoPdf">
                <i class="bi bi-file-earmark-pdf"></i> @(generandoPdf ? "Generando..." : "Descargar Reporte")
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(mensajeErrorPdf))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @mensajeErrorPdf
            <button type="button" class="btn-close" @onclick="() => mensajeErrorPdf = null"></button>
        </div>
    }

    @* Mensaje de éxito al descargar *@
    @if (mostrarAlertaDescarga)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            El reporte en PDF se ha generado y descargado exitosamente.
            <button type="button" class="btn-close" @onclick="() => mostrarAlertaDescarga = false"></button>
        </div>
    }

    @if (historial == null)
    {
        <div class="alert alert-info shadow-sm">Cargando historial médico...</div>
    }
    else if (!historial.Any())
    {
        <div class="alert alert-warning shadow-sm">Aún no hay registros médicos para esta mascota.</div>
    }
    else
    {
        <div class="card shadow-sm border-0">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Fecha</th>
                                <th>Veterinario</th>
                                <th>Servicio</th>
                                <th>Diagnóstico / Notas</th>
                                <th>Peso</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var registro in historial)
                            {
                                <tr>
                                    <td class="fw-bold">@registro.Fecha</td>
                                    <td>@registro.Veterinario</td>
                                    <td><span class="badge badge-mimados-primary">@registro.Servicio</span></td>
                                    <td>@registro.Notas</td>
                                    <td>@registro.Peso kg</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public int Id { get; set; }

    private string nombreMascota = "";
    private bool mostrarAlertaDescarga = false;


    private List<RegistroMedico>? historial = null ; 

    protected override async Task OnInitializedAsync()
    {
        // 1. Buscamos la mascota para sacar su nombre real
        var mascota = await MascotaService.ObtenerMascotaPorIdAsync(Id);
        nombreMascota = mascota?.Nombre ?? "Mascota Desconocida";

        // 2. Traemos el historial real desde el backend
        historial = await MascotaService.ObtenerHistorialAsync(Id);
    }

    private void Volver()
    {
        Nav.NavigateTo("/cliente/mascotas");
    }

    private bool generandoPdf = false;
    private string? mensajeErrorPdf;

    private async Task ImprimirReporte()
    {
        if (generandoPdf) return;
        generandoPdf = true;
        mensajeErrorPdf = null;
        mostrarAlertaDescarga = false;

        try
        {
            var pdfBytes = await MascotaService.DescargarPdfHistorialAsync(Id);
            if (pdfBytes != null && pdfBytes.Length > 0)
            {
                await using var module = await JS.InvokeAsync<IJSObjectReference>(
                    "import",
                    "data:text/javascript;charset=utf-8," + Uri.EscapeDataString("""
                        export function descargarPdf(bytes, fileName) {
                            const blob = new Blob([bytes], { type: 'application/pdf' });
                            const url = URL.createObjectURL(blob);
                            const win = window.open(url, '_blank');
                            if (!win) {
                                const a = document.createElement('a');
                                a.href = url;
                                a.download = fileName;
                                a.click();
                            }
                        }
                    """));

                await module.InvokeVoidAsync("descargarPdf", pdfBytes, $"Historial_Mascota_{Id}.pdf");
                mostrarAlertaDescarga = true;
            }
            else
            {
                mensajeErrorPdf = "No se pudo generar el reporte PDF. Verifica que el servidor backend esté activo.";
            }
        }
        catch (Exception)
        {
            mensajeErrorPdf = "Ocurrió un error al descargar el reporte PDF.";
        }
        finally
        {
            generandoPdf = false;
        }
    }

    
    
}