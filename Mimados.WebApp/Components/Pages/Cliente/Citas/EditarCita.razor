@page "/cliente/citas/editar/{Id:int}"
@rendermode InteractiveServer

@using Mimados.WebApp.Models
@using Mimados.WebApp.Services

@inject ICitaService CitaService

<PageTitle>Editar Cita - Mimados</PageTitle>

<div class="container mt-4" style="max-width: 800px;">

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <h2 class="mb-0">Modificar Cita</h2>

        <a class="btn btn-secondary"
           href="@($"/cliente/citas/detalle/{Id}")">
            <i class="bi bi-arrow-left me-1"></i>
            Volver al detalle
        </a>
    </div>

    @if (cargando)
    {
        <div class="alert alert-info">
            Cargando información de la cita...
        </div>
    }
    else if (cita == null)
    {
        <div class="alert alert-warning">
            No se encontró la cita solicitada.
        </div>

        @if (!string.IsNullOrEmpty(mensajeError))
        {
            <div class="alert alert-danger">
                @mensajeError
            </div>
        }
    }
    else
    {
        <div class="card p-4 shadow-sm border-0 bg-white">

            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                <h5 class="fw-bold mb-0">
                    <i class="bi bi-pencil-square text-primary me-2"></i>
                    Editar datos de la cita @($"C-{cita.CitaId:D3}")
                </h5>

                <span class="badge @ObtenerColorEstado(cita.Estado)">
                    @cita.Estado
                </span>
            </div>

            @if (cambiosGuardados)
            {
                <div class="alert alert-success">
                    Cita modificada correctamente.

                    <a class="alert-link ms-1"
                       href="/cliente/citas">
                        Volver a Mis Citas
                    </a>
                </div>
            }
            else if (!PuedeEditar())
            {
                <div class="alert alert-warning">
                    Esta cita no puede modificarse debido a su estado.
                </div>
            }
            else
            {
                <div class="row">

                    <!-- Mascota -->
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">
                            Mascota:
                        </label>

                        <input class="form-control"
                               value="@($"Mascota ID {cita.MascotaId}")"
                               disabled />
                    </div>

                    <!-- Empleado -->
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">
                            Veterinario / Empleado:
                        </label>

                        <input class="form-control"
                               value="@($"Empleado ID {cita.EmpleadoId}")"
                               disabled />
                    </div>

                    <!-- Fecha -->
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">
                            Fecha de la cita:
                        </label>

                        <input type="date"
                               class="form-control"
                               min="@DateTime.Today.ToString("yyyy-MM-dd")"
                               @bind="fecha" />
                    </div>

                    <!-- Hora -->
                    
                    <div class="row">
                        <div class="col-6">
                            <label class="form-label">Hora (24 h):</label>
                            <select class="form-select" @bind="Hora24">
                                @for (int i = 0; i < 24; i++)
                                {
                                    <option value="@i">@($"{i:00}")</option>
                                }
                            </select>
                        </div>

                        <div class="col-6">
                            <label class="form-label">Minutos:</label>
                            <select class="form-select" @bind="Minuto">
                                @for (int i = 0; i < 60; i += 5)
                                {
                                    <option value="@i">@($"{i:00}")</option>
                                }
                            </select>
                        </div>
                    </div>

                    <small class="text-muted">
                        Hora seleccionada (24 h):
                        @(hora?.ToString("HH:mm") ?? "--:--")
                    </small>


                    <!-- Duración definida por la clínica -->
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">
                            Duración de la cita:
                        </label>

                        <input class="form-control"
                               value="30 minutos"
                               readonly />
                        <small class="text-muted">
                            Duración establecida por la clínica.
                        </small>
                    </div>

                    <!-- Motivo -->
                    <div class="col-12 mb-3">
                        <label class="form-label fw-bold">
                            Motivo de la cita:
                        </label>

                        <textarea class="form-control"
                                  rows="3"
                                  maxlength="255"
                                  @bind="motivo"></textarea>
                    </div>

                </div>

                @if (!string.IsNullOrEmpty(mensajeError))
                {
                    <div class="alert alert-danger mt-2">
                        @mensajeError
                    </div>
                }

                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-3">

                    <a href="/cliente/citas"
                       class="btn btn-secondary">
                        Cancelar edición
                    </a>

                    <button type="button"
                            class="btn btn-primary fw-bold px-4"
                            disabled="@procesando"
                            @onclick="GuardarCambios">

                        <i class="bi bi-pencil-square me-1"></i>
                        @(procesando ? "Guardando..." : "Guardar Cambios")
                    </button>

                </div>
            }

        </div>
    }
</div>

@code {

    [Parameter]
    public int Id { get; set; }

    private Cita? cita;

    private DateTime fecha = DateTime.Today;
    private TimeOnly? hora;
    private const int DuracionCitaMinutos = 30;
    private string motivo = "";

    private bool cargando = true;
    private bool procesando = false;
    private bool cambiosGuardados = false;

    private string mensajeError = "";

    // Obtener datos reales de la cita
    protected override async Task OnParametersSetAsync()
    {
        cargando = true;
        mensajeError = "";
        cambiosGuardados = false;
        cita = null;

        try
        {
            cita = await CitaService.ObtenerPorIdAsync(Id);

            if (cita != null)
            {
                fecha = cita.FechaHoraInicio.Date;
                hora = TimeOnly.FromDateTime(cita.FechaHoraInicio);

                motivo = cita.Motivo ?? "";
            }
        }
        catch (Exception)
        {
            mensajeError = "No se pudo cargar la información de la cita.";
        }
        finally
        {
            cargando = false;
        }
    }

    // Validar si la cita puede editarse
    private bool PuedeEditar()
    {
        return cita != null &&
            (cita.Estado == "PROGRAMADA" ||
             cita.Estado == "CONFIRMADA");
    }

    // Guardar cambios mediante REST
    private async Task GuardarCambios()
    {
        if (procesando || !PuedeEditar())
            return;

        mensajeError = "";

        if (!hora.HasValue)
        {
            mensajeError = "Debe seleccionar una hora.";
            return;
        }

        DateTime fechaInicio =
            fecha.Date.Add(hora.Value.ToTimeSpan());

        if (fechaInicio <= DateTime.Now)
        {
            mensajeError = "La fecha y hora deben ser futuras.";
            return;
        }

        if (string.IsNullOrWhiteSpace(motivo))
        {
            mensajeError = "Debe ingresar el motivo de la cita.";
            return;
        }

        DateTime fechaFin =
            fechaInicio.AddMinutes(DuracionCitaMinutos);

        Cita citaActualizada = new Cita
        {
            CitaId = Id,
            EmpleadoId = cita!.EmpleadoId,
            MascotaId = cita.MascotaId,
            FechaHoraInicio = fechaInicio,
            FechaHoraFin = fechaFin,
            Estado = cita.Estado,
            Motivo = motivo.Trim()
        };

        procesando = true;

        try
        {
            bool resultado = await CitaService.ModificarAsync(citaActualizada);

            if (resultado)
            {
                cita = citaActualizada;
                cambiosGuardados = true;
            }
            else
            {
                mensajeError = "No se pudo modificar la cita.";
            }
        }
        catch (InvalidOperationException ex)
        {
            mensajeError = ex.Message;
        }
        catch (Exception)
        {
            mensajeError = "No se pudo modificar la cita. Inténtalo nuevamente.";
        }
        finally
        {
            procesando = false;
        }
    }

    private string ObtenerColorEstado(string estado)
    {
        return estado?.ToUpperInvariant() switch
        {
            "PROGRAMADA" => "badge-mimados-primary",
            "CONFIRMADA" => "badge-mimados-solid",
            "ATENDIDA" => "badge-mimados-neutral",
            "CANCELADA" => "badge-mimados-danger",
            _ => "badge-mimados-neutral"
        };
    }

    
    private int Hora24
    {
        get => hora?.Hour ?? 10;
        set => hora = new TimeOnly(value, hora?.Minute ?? 0);
    }

    private int Minuto
    {
        get => hora?.Minute ?? 0;
        set => hora = new TimeOnly(hora?.Hour ?? 10, value);
    }

}
