@page "/cliente/citas"
@rendermode InteractiveServer

@using Mimados.WebApp.Models
@using Microsoft.AspNetCore.Components.Authorization

@inject ICitaService CitaService
@inject IMascotaService MascotaService
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Mis Citas - Mimados</PageTitle>

<div class="container mt-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <div>
            <h2 class="mb-1">Mis Citas</h2>
            <p class="text-muted mb-0">
                Consulta y administra tus reservas veterinarias.
            </p>
        </div>
        <a class="btn btn-primary" href="/cliente/citas/nueva">
            <i class="bi bi-calendar-plus me-1"></i>
            Reservar Nueva Cita
        </a>
    </div>

    <div class="card shadow-sm border-0 bg-white">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0 fw-bold">
                <i class="bi bi-calendar-check text-primary me-2"></i>
                Mis reservas
            </h5>
            <a class="btn btn-outline-primary btn-sm"
               href="/cliente/citas/disponibilidad">
                Ver disponibilidad
            </a>
        </div>

        <div class="card-body p-0">
            @if (cargando)
            {
                <div class="alert alert-info m-3">Cargando citas...</div>
            }
            else if (!string.IsNullOrEmpty(mensajeError))
            {
                <div class="alert alert-danger m-3">@mensajeError</div>
            }
            else if (listaCitas.Count == 0)
            {
                <div class="alert alert-info m-3">No tienes citas registradas.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3">Código</th>
                                <th>Mascota</th>
                                <th>Motivo</th>
                                <th>Fecha y hora</th>
                                <th>Estado</th>
                                <th class="text-end pe-3">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var cita in CitasPagina)
                            {
                                <tr>
                                    <td class="ps-3">@($"C-{cita.CitaId:D3}")</td>
                                    <td>@cita.NombreMascota</td>
                                    <td>@cita.Motivo</td>
                                    <td>@cita.FechaHoraInicio.ToString("dd/MM/yyyy, HH:mm")</td>
                                    <td>
                                        <span class="badge @ObtenerColorEstado(cita.Estado)">
                                            @cita.Estado
                                        </span>
                                    </td>
                                    <td class="text-end pe-3">
                                        <div class="d-inline-flex gap-1">
                                            <a class="btn btn-outline-primary btn-sm"
                                               href="@($"/cliente/citas/detalle/{cita.CitaId}")">
                                                Ver
                                            </a>
                                            @if (cita.Estado == "PROGRAMADA" || cita.Estado == "CONFIRMADA")
                                            {
                                                <a class="btn btn-outline-secondary btn-sm"
                                                   href="@($"/cliente/citas/editar/{cita.CitaId}")">
                                                    Editar
                                                </a>
                                                <a class="btn btn-outline-danger btn-sm"
                                                   href="@($"/cliente/citas/cancelar/{cita.CitaId}")">
                                                    Cancelar
                                                </a>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 px-3 py-3 border-top">
                    <span class="text-muted small">
                        Mostrando @((paginaActual - 1) * CITAS_POR_PAGINA + 1)-@Math.Min(paginaActual * CITAS_POR_PAGINA, listaCitas.Count)
                        de @listaCitas.Count citas
                    </span>

                    @if (TotalPaginas > 1)
                    {
                        <nav aria-label="Paginación de mis citas">
                            <ul class="pagination pagination-sm mb-0">
                                <li class="page-item @(paginaActual == 1 ? "disabled" : "")">
                                    <button type="button" class="page-link"
                                            disabled="@(paginaActual == 1)"
                                            @onclick="() => CambiarPagina(paginaActual - 1)">
                                        Anterior
                                    </button>
                                </li>

                                @foreach (var numeroPagina in PaginasVisibles)
                                {
                                    <li class="page-item @(numeroPagina == paginaActual ? "active" : "")">
                                        <button type="button" class="page-link"
                                                aria-label="Ir a la página @numeroPagina"
                                                aria-current="@(numeroPagina == paginaActual ? "page" : null)"
                                                @onclick="() => CambiarPagina(numeroPagina)">
                                            @numeroPagina
                                        </button>
                                    </li>
                                }

                                <li class="page-item @(paginaActual == TotalPaginas ? "disabled" : "")">
                                    <button type="button" class="page-link"
                                            disabled="@(paginaActual == TotalPaginas)"
                                            @onclick="() => CambiarPagina(paginaActual + 1)">
                                        Siguiente
                                    </button>
                                </li>
                            </ul>
                        </nav>
                    }
                </div>
            }
        </div>
    </div>
</div>

@code {
    private const int CITAS_POR_PAGINA = 10;
    private List<Cita> listaCitas = new();
    private int paginaActual = 1;

    private int TotalPaginas =>
        (listaCitas.Count + CITAS_POR_PAGINA - 1) / CITAS_POR_PAGINA;

    private IEnumerable<Cita> CitasPagina => listaCitas
        .Skip((paginaActual - 1) * CITAS_POR_PAGINA)
        .Take(CITAS_POR_PAGINA);

    private IEnumerable<int> PaginasVisibles
    {
        get
        {
            const int MAX_PAGINAS_VISIBLES = 5;

            int inicio = Math.Max(1, paginaActual - 2);

            int fin = Math.Min(
                TotalPaginas,
                inicio + MAX_PAGINAS_VISIBLES - 1
            );

            inicio = Math.Max(
                1,
                fin - MAX_PAGINAS_VISIBLES + 1
            );

            return Enumerable.Range(inicio, fin - inicio + 1);
        }
    }

    private void CambiarPagina(int nuevaPagina)
    {
        if (nuevaPagina >= 1 && nuevaPagina <= TotalPaginas)
        {
            paginaActual = nuevaPagina;
        }
    }

    private bool cargando = true;
    private string mensajeError = "";

    protected override async Task OnInitializedAsync()
    {
        cargando = true;
        mensajeError = "";

        try
        {
            var estado = await AuthStateProvider.GetAuthenticationStateAsync();
            var usuario = estado.User;

            string? idTexto = usuario.FindFirst("UsuarioId")?.Value;

            if (usuario.Identity?.IsAuthenticated != true ||
                !int.TryParse(idTexto, out int usuarioId))
            {
                mensajeError = "No se pudo identificar al cliente que inició sesión.";
                return;
            }

            var mascotas = await MascotaService.ObtenerMascotasPorClienteAsync(usuarioId);

            var tareas = mascotas.Select(async mascota =>
            {
                var citasMascota = await CitaService
                    .ListarPorMascotaAsync(mascota.MascotaId);

                foreach (var cita in citasMascota)
                {
                    cita.NombreMascota = mascota.Nombre;
                }

                return citasMascota;
            });

            var resultados = await Task.WhenAll(tareas);

            listaCitas = resultados
                .SelectMany(citas => citas)
                .OrderByDescending(c => c.FechaHoraInicio)
                .ThenByDescending(c => c.CitaId)
                .ToList();

            paginaActual = 1;
        }
        catch (Exception)
        {
            mensajeError = "No se pudieron cargar tus citas. Inténtalo nuevamente.";
        }
        finally
        {
            cargando = false;
        }
    }

    private string ObtenerColorEstado(string estado)
    {
        return estado?.ToUpperInvariant() switch
        {
            "CONFIRMADA" => "badge-mimados-solid",
            "PROGRAMADA" => "badge-mimados-primary",
            "ATENDIDA" => "badge-mimados-neutral",
            "CANCELADA" => "badge-mimados-danger",
            "NO_ASISTIO" => "badge-mimados-neutral",
            _ => "badge-mimados-neutral"
        };
    }
}
