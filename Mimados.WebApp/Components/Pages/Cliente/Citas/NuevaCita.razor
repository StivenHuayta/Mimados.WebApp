@page "/cliente/citas/nueva"
@rendermode InteractiveServer

@using System.Globalization
@using Microsoft.AspNetCore.Components
@using Mimados.WebApp.Models
@using Mimados.WebApp.Services
@using Microsoft.AspNetCore.Components.Authorization

@inject IMascotaService MascotaService
@inject AuthenticationStateProvider AuthenticationStateProvider

@inject ICitaService CitaService
@inject IVeterinarioService VeterinarioService
@inject IDisponibilidadService DisponibilidadService

<PageTitle>Reservar Cita - Mimados</PageTitle>

<div class="container mt-4" style="max-width: 920px;">

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <div>
            <h2 class="mb-1">Reservar Cita</h2>
            <p class="text-muted mb-0">
                Completa los datos para reservar una atención.
            </p>
        </div>

        <a class="btn btn-secondary" href="/cliente/citas">
            Volver a Mis Citas
        </a>
    </div>

    <div class="card p-4 shadow-sm border-0 bg-white">

        <h5 class="fw-bold mb-3">
            <i class="bi bi-calendar-plus text-primary me-2"></i>
            Datos de la reserva
        </h5>

        @if (cargandoVeterinarios)
        {
            <div class="alert alert-info">
                Cargando veterinarios...
            </div>
        }

        <div class="row">

            <!-- Mascotas activas del cliente autenticado -->
            <div class="col-md-6 mb-3">
                <label class="form-label fw-bold" for="mascotaSelect">
                    Mascota:
                </label>

                <select id="mascotaSelect"
                        class="form-select"
                        @bind="mascotaId"
                        disabled="@(cargandoMascotas || mascotas.Count == 0 || reservaConfirmada)">
                    <option value="0">-- Seleccione una mascota --</option>

                    @foreach (var mascota in mascotas)
                    {
                        <option value="@mascota.MascotaId">@mascota.Nombre</option>
                    }
                </select>

                @if (cargandoMascotas)
                {
                    <small class="text-muted">Cargando mascotas...</small>
                }
                else if (!string.IsNullOrWhiteSpace(mensajeMascotas))
                {
                    <small class="text-danger">@mensajeMascotas</small>
                }
            </div>

            <!-- Veterinarios reales -->
            <div class="col-md-6 mb-3">
                <label class="form-label fw-bold">
                    Veterinario:
                </label>

                <select class="form-select"
                        @bind="empleadoId"
                        disabled="@cargandoVeterinarios">

                    <option value="0">
                        -- Seleccione un veterinario --
                    </option>

                    @foreach (var veterinario in veterinarios)
                    {
                        <option value="@veterinario.EmpleadoId">
                            @veterinario.Nombre - @veterinario.Sede
                        </option>
                    }
                </select>
            </div>

            <!-- Fecha -->
            <div class="col-md-6 mb-3">
                <label class="form-label fw-bold">
                    Fecha:
                </label>

                <input type="date"
                       class="form-control"
                       min="@DateTime.Today.ToString("yyyy-MM-dd")"
                       @bind="fecha" />
            </div>

            <!-- Hora en formato de 24 horas -->
            <div class="col-md-3 mb-3">
                <label class="form-label fw-bold">Hora (24 h):</label>
                <select class="form-select" @bind="Hora24">
                    @for (int i = 0; i < 24; i++)
                    {
                        <option value="@i">@($"{i:00}")</option>
                    }
                </select>
            </div>

            <div class="col-md-3 mb-3">
                <label class="form-label fw-bold">Minutos:</label>
                <select class="form-select" @bind="Minuto">
                    @for (int i = 0; i < 60; i += 5)
                    {
                        <option value="@i">@($"{i:00}")</option>
                    }
                </select>
                <small class="text-muted">
                    Hora seleccionada: @(hora?.ToString("HH:mm") ?? "--:--")
                </small>
            </div>

            <!-- Duración definida por la clínica; el cliente no la selecciona -->
            <div class="col-md-6 mb-3">
                <label class="form-label fw-bold">Duración de la cita:</label>
                <div class="form-control bg-white">30 minutos</div>
                <small class="text-muted">Duración establecida por la clínica.</small>
            </div>

            <!-- Motivo -->
            <div class="col-12 mb-4">
                <label class="form-label fw-bold">
                    Motivo de la cita:
                </label>

                <textarea class="form-control"
                          rows="3"
                          maxlength="255"
                          @bind="motivo"
                          placeholder="Motivo de la visita"></textarea>
            </div>

        </div>

        <div class="d-flex flex-wrap justify-content-between gap-2">

            <a class="btn btn-outline-primary"
               href="/cliente/citas/disponibilidad">
                <i class="bi bi-search me-1"></i>
                Consultar Disponibilidad
            </a>

            <button type="button"
                    class="btn btn-primary px-4"
                    disabled="@(procesando || reservaConfirmada || cargandoVeterinarios || cargandoMascotas || mascotas.Count == 0)"
                    @onclick="ConfirmarReserva">

                @(procesando ? "Registrando..." : "Reservar Cita")
            </button>
        </div>

        @if (!string.IsNullOrEmpty(mensajeError))
        {
            <div class="alert alert-danger mt-3">
                @mensajeError
            </div>
        }

        @if (reservaConfirmada)
        {
            <div class="alert alert-success mt-3">
                Cita registrada correctamente.

                <a href="/cliente/citas" class="alert-link ms-1">
                    Ver mis citas
                </a>
            </div>
        }

    </div>
</div>

@code {

    // Parametros recibidos desde Disponibilidad
    [SupplyParameterFromQuery(Name = "empleadoId")]
    public int? EmpleadoIdQuery { get; set; }

    [SupplyParameterFromQuery(Name = "fecha")]
    public string? FechaQuery { get; set; }

    [SupplyParameterFromQuery(Name = "hora")]
    public string? HoraQuery { get; set; }

    // Datos del formulario
    private int mascotaId = 0;
    private int empleadoId = 0;

    private DateTime fecha = DateTime.Today.AddDays(1);
    private TimeOnly? hora = new TimeOnly(10, 0);

    private const int DuracionCitaMinutos = 30;
    private string motivo = "";

    // Veterinarios reales
    private List<VeterinarioResumenDto> veterinarios = new();

    // Estado
    private bool cargandoVeterinarios = true;
    private bool cargandoMascotas = true;
    private bool procesando = false;
    private bool reservaConfirmada = false;
    private string mensajeError = "";
    private string mensajeMascotas = "";

    private List<Mascota> mascotas = new();


    // Cargar veterinarios y recibir seleccion
    protected override async Task OnParametersSetAsync()
    {
        cargandoVeterinarios = true;
        mensajeError = "";

        try
        {
            veterinarios = await VeterinarioService.ListarAsync();

            if (EmpleadoIdQuery.HasValue)
            {
                int id = EmpleadoIdQuery.Value;

                if (veterinarios.Any(v => v.EmpleadoId == id))
                {
                    empleadoId = id;
                }
                else
                {
                    empleadoId = 0;
                    mensajeError = "El veterinario seleccionado no está disponible.";
                }
            }

            if (!string.IsNullOrWhiteSpace(FechaQuery) &&
                DateTime.TryParseExact(
                    FechaQuery,
                    "yyyy-MM-dd",
                    CultureInfo.InvariantCulture,
                    DateTimeStyles.None,
                    out DateTime fechaRecibida))
            {
                fecha = fechaRecibida;
            }

            if (!string.IsNullOrWhiteSpace(HoraQuery) &&
                TimeOnly.TryParse(HoraQuery, out TimeOnly horaRecibida))
            {
                hora = horaRecibida;
            }

        }
        catch (Exception)
        {
            mensajeError = "No se pudieron cargar los veterinarios. Inténtalo nuevamente.";
        }
        finally
        {
            cargandoVeterinarios = false;
        }
    }

    // Registrar cita mediante Java
    private async Task ConfirmarReserva()
    {
        if (procesando || reservaConfirmada)
            return;

        mensajeError = "";

        if (mascotaId <= 0 || !mascotas.Any(m => m.MascotaId == mascotaId))
        {
            mensajeError = "Seleccione una mascota válida de su cuenta.";
            return;
        }

        if (empleadoId <= 0)
        {
            mensajeError = "Seleccione un veterinario.";
            return;
        }

        if (!veterinarios.Any(v => v.EmpleadoId == empleadoId))
        {
            mensajeError = "Seleccione un veterinario válido.";
            return;
        }

        if (!hora.HasValue)
        {
            mensajeError = "Seleccione una hora.";
            return;
        }

        DateTime fechaInicio =
            fecha.Date.Add(hora.Value.ToTimeSpan());

        if (fechaInicio <= DateTime.Now)
        {
            mensajeError = "La fecha y hora deben ser futuras.";
            return;
        }

        if (string.IsNullOrWhiteSpace(motivo))
        {
            mensajeError = "Ingrese el motivo de la cita.";
            return;
        }

        DateTime fechaFin =
            fechaInicio.AddMinutes(DuracionCitaMinutos);

        procesando = true;

        try
        {
            // Comprobar nuevamente el horario
            var horariosLibres =
                await DisponibilidadService.ConsultarAsync(
                    empleadoId, fecha, DuracionCitaMinutos);

            bool horarioDisponible = horariosLibres.Any(h =>
                TimeOnly.TryParse(h, out var horaLibre) &&
                horaLibre == TimeOnly.FromDateTime(fechaInicio));

            if (!horarioDisponible)
            {
                mensajeError =
                    "El horario seleccionado ya no está disponible.";
                return;
            }

            // Crear cita
            Cita nuevaCita = new Cita
            {
                MascotaId = mascotaId,
                EmpleadoId = empleadoId,
                FechaHoraInicio = fechaInicio,
                FechaHoraFin = fechaFin,
                Motivo = motivo.Trim()
            };

            bool resultado =
                await CitaService.RegistrarAsync(nuevaCita);

            if (resultado)
            {
                reservaConfirmada = true;
            }
            else
            {
                mensajeError = "No se pudo registrar la cita.";
            }
        }
        catch (Exception)
        {
            mensajeError = "No se pudo completar la reserva. Inténtalo nuevamente.";
        }
        finally
        {
            procesando = false;
        }
    }

    

    private async Task CargarMascotasAsync()
    {
        cargandoMascotas = true;
        mascotas = new List<Mascota>();
        mascotaId = 0;
        mensajeMascotas = "";

        try
        {
            var estado = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var usuario = estado.User;
            var idTexto = usuario.FindFirst("UsuarioId")?.Value;

            if (usuario.Identity?.IsAuthenticated != true ||
                !int.TryParse(idTexto, out int usuarioId))
            {
                mensajeMascotas = "No se pudo identificar al cliente. Inicia sesión nuevamente.";
                return;
            }

            var resultado = await MascotaService.ObtenerMascotasPorClienteAsync(usuarioId);
            mascotas = (resultado ?? new List<Mascota>())
                .Where(m => m.Activo)
                .ToList();

            if (mascotas.Count == 0)
            {
                mensajeMascotas = "No hay mascotas activas registradas para esta cuenta.";
            }
        }
        catch (Exception)
        {
            mensajeMascotas = "No se pudieron cargar tus mascotas. Inténtalo nuevamente.";
        }
        finally
        {
            cargandoMascotas = false;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await CargarMascotasAsync();
    }

    private int Hora24
    {
        get => hora?.Hour ?? 10;
        set => hora = new TimeOnly(value, hora?.Minute ?? 0);
    }

    private int Minuto
    {
        get => hora?.Minute ?? 0;
        set => hora = new TimeOnly(hora?.Hour ?? 10, value);
    }

}
