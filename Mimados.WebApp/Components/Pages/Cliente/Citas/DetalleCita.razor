@page "/cliente/citas/detalle/{Id:int}"
@rendermode InteractiveServer

@using Mimados.WebApp.Models
@using Mimados.WebApp.Services

@inject ICitaService CitaService

<PageTitle>Detalle de Cita - Mimados</PageTitle>

<div class="container mt-4" style="max-width: 850px;">

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <h2 class="mb-0">Detalle de Cita</h2>

        <a class="btn btn-secondary" href="/cliente/citas">
            <i class="bi bi-arrow-left me-1"></i>
            Mis Citas
        </a>
    </div>

    @if (cargando)
    {
        <div class="alert alert-info">
            Cargando información de la cita...
        </div>
    }
    else if (!string.IsNullOrEmpty(mensajeError))
    {
        <div class="alert alert-danger">
            @mensajeError
        </div>
    }
    else if (cita != null)
    {
        <div class="card shadow-sm border-0 bg-white">

            <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">

                <h5 class="mb-0 fw-bold text-white">
                    Cita @($"C-{cita.CitaId:D3}")
                </h5>

                <span class="badge @ObtenerColorEstado(cita.Estado)">
                    @cita.Estado
                </span>

            </div>

            <div class="card-body p-4">
                <div class="row g-3">

                    <div class="col-md-6">
                        <span class="text-muted">ID de Mascota</span>
                        <p class="fw-semibold mb-0">
                            @cita.MascotaId
                        </p>
                    </div>

                    <div class="col-md-6">
                        <span class="text-muted">ID de Empleado</span>
                        <p class="fw-semibold mb-0">
                            @cita.EmpleadoId
                        </p>
                    </div>

                    <div class="col-md-6">
                        <span class="text-muted">Fecha y hora de inicio</span>
                        <p class="fw-semibold mb-0">
                            @cita.FechaHoraInicio.ToString("dd/MM/yyyy HH:mm")
                        </p>
                    </div>

                    <div class="col-md-6">
                        <span class="text-muted">Fecha y hora de fin</span>
                        <p class="fw-semibold mb-0">
                            @cita.FechaHoraFin.ToString("dd/MM/yyyy HH:mm")
                        </p>
                    </div>

                    <div class="col-md-6">
                        <span class="text-muted">Estado</span>
                        <p class="fw-semibold mb-0">
                            @cita.Estado
                        </p>
                    </div>

                    <div class="col-md-12">
                        <span class="text-muted">Motivo</span>
                        <p class="fw-semibold mb-0">
                            @cita.Motivo
                        </p>
                    </div>

                </div>
            </div>

            <div class="card-footer bg-white d-flex justify-content-end py-3">
                <a class="btn btn-secondary" href="/cliente/citas">
                    Volver a Mis Citas
                </a>
            </div>

        </div>
    }

</div>

@code {

    [Parameter]
    public int Id { get; set; }

    private Cita? cita;
    private bool cargando = true;
    private string mensajeError = "";

    protected override async Task OnParametersSetAsync()
    {
        cargando = true;
        mensajeError = "";
        cita = null;

        try
        {
            cita = await CitaService.ObtenerPorIdAsync(Id);

            if (cita == null)
            {
                mensajeError = "No se encontró la cita solicitada.";
            }
        }
        catch (Exception)
        {
            mensajeError = "No se pudo consultar la cita. Verifica la conexión con Java.";
        }
        finally
        {
            cargando = false;
        }
    }

    private string ObtenerColorEstado(string estado)
    {
        return estado?.ToUpperInvariant() switch
        {
            "CONFIRMADA" => "bg-white text-primary",
            "PROGRAMADA" => "badge-mimados-primary",
            "ATENDIDA" => "badge-mimados-neutral",
            "CANCELADA" => "badge-mimados-danger",
            "NO_ASISTIO" => "badge-mimados-neutral",
            _ => "badge-mimados-neutral"
        };
    }
}
