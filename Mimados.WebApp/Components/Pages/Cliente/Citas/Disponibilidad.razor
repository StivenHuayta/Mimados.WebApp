@page "/cliente/citas/disponibilidad"
@rendermode InteractiveServer

@using Mimados.WebApp.Services

@inject IVeterinarioService VeterinarioService
@inject IDisponibilidadService DisponibilidadService

<PageTitle>Disponibilidad de Veterinarios - Mimados</PageTitle>

<div class="container mt-4">

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <div>
            <h2 class="mb-1">Disponibilidad de Veterinarios</h2>
            <p class="text-muted mb-0">
                Consulta las opciones de atención según sede,
                fecha y horario.
            </p>
        </div>

        <a class="btn btn-secondary" href="/cliente/citas">
            <i class="bi bi-calendar-check me-1"></i>
            Ir a Mis Citas
        </a>
    </div>

    <!-- Filtros -->
    <div class="card p-4 shadow-sm border-0 bg-white mb-4">

        <h5 class="fw-bold mb-3">
            <i class="bi bi-funnel text-primary me-2"></i>
            Buscar disponibilidad
        </h5>

        <div class="row">

            <!-- Sede -->
            <div class="col-md-6 col-lg-4 mb-3">
                <label class="form-label fw-bold">Sede:</label>

                <select class="form-select" @bind="sedeFiltro">
                    <option value="">Todas las sedes</option>

                    @foreach (var sede in sedes)
                    {
                        <option value="@sede">@sede</option>
                    }
                </select>
            </div>

            <!-- Fecha -->
            <div class="col-md-6 col-lg-4 mb-3">
                <label class="form-label fw-bold">Fecha:</label>

                <input type="date"
                       class="form-control"
                       min="@DateTime.Today.ToString("yyyy-MM-dd")"
                       @bind="fechaFiltro" />
            </div>

            <!-- Horario -->
            <div class="col-md-6 col-lg-4 mb-3">
                <label class="form-label fw-bold">Horario:</label>

                <select class="form-select" @bind="horarioFiltro">
                    <option value="">Cualquier horario</option>
                    <option value="manana">Mañana</option>
                    <option value="tarde">Tarde</option>
                </select>
            </div>

            <!-- Duracion -->
            <div class="col-md-3 mb-3">
                <label class="form-label fw-bold">
                    Duración de la cita:
                </label>

                <input class="form-control"
                       value="30 minutos"
                       readonly />
            </div>

        </div>

        <div class="text-end">
            <button type="button"
                    class="btn btn-primary px-4"
                    disabled="@(consultando || cargando)"
                    @onclick="BuscarDisponibilidad">

                <i class="bi bi-search me-1"></i>
                @(consultando ? "Consultando..." : "Consultar Disponibilidad")
            </button>
        </div>
    </div>

    @if (cargando)
    {
        <div class="alert alert-info">
            Cargando veterinarios...
        </div>
    }

    @if (!string.IsNullOrEmpty(mensajeError))
    {
        <div class="alert alert-danger">
            @mensajeError
        </div>
    }

    <!-- Resultados -->
    @if (mostrarResultados)
    {
        <div class="d-flex justify-content-between align-items-center mb-3">

            <h5 class="fw-bold mb-0">
                Veterinarios disponibles
            </h5>

            <span class="badge badge-mimados-primary">
                @resultados.Count veterinarios
            </span>
        </div>

        @if (resultados.Count == 0)
        {
            <div class="alert alert-info">
                No se encontraron veterinarios disponibles
                para los filtros seleccionados.
            </div>
        }
        else
        {
            <div class="row row-cols-1 row-cols-md-2 g-4">

                @foreach (var resultado in resultados)
                {
                    <div class="col">
                        <div class="card h-100 shadow-sm border-0 bg-white">

                            <div class="card-header bg-primary text-white">
                                <h5 class="mb-0 fw-bold text-white">
                                    <i class="bi bi-person-badge me-2"></i>
                                    @resultado.Veterinario.Nombre
                                </h5>
                            </div>

                            <div class="card-body">

                                <p class="mb-2">
                                    <strong>Puesto:</strong>
                                    @resultado.Veterinario.Puesto
                                </p>

                                <p class="mb-2">
                                    <strong>Sede:</strong>
                                    @resultado.Veterinario.Sede
                                </p>

                                <p class="mb-3">
                                    <strong>Fecha:</strong>
                                    @fechaFiltro.ToString("dd/MM/yyyy")
                                </p>

                                <p class="mb-2 fw-bold">
                                    Horarios disponibles:
                                </p>

                                <div class="d-flex flex-wrap gap-2">

                                    
                                    @foreach (var hora in resultado.Horarios)
                                    {
                                        <a class="btn btn-outline-primary btn-sm"
                                           href="@CrearEnlaceReserva(resultado.Veterinario.EmpleadoId, hora)">
                                            <i class="bi bi-calendar-plus me-1"></i>
                                            @hora - Reservar
                                        </a>
                                    }


                                </div>

                            </div>

                            <div class="card-footer bg-white">
                                <small class="text-muted">
                                    @resultado.Horarios.Count horarios disponibles
                                </small>
                            </div>

                        </div>
                    </div>
                }

            </div>
        }
    }
</div>

@code {

    // Veterinarios obtenidos desde Java
    private List<VeterinarioResumenDto> veterinarios = new();
    private List<string> sedes = new();

    // Filtros
    private string sedeFiltro = "";
    private string horarioFiltro = "";
    private DateTime fechaFiltro = DateTime.Today.AddDays(1);
    private int duracionMinutos = 30;

    // Resultados
    private List<ResultadoDisponibilidad> resultados = new();

    // Estado
    private bool cargando = true;
    private bool consultando = false;
    private bool mostrarResultados = false;
    private string mensajeError = "";

    // Clase auxiliar para mostrar los resultados
    private class ResultadoDisponibilidad
    {
        public VeterinarioResumenDto Veterinario { get; set; } = new();
        public List<string> Horarios { get; set; } = new();
    }

    // Cargar los veterinarios al abrir la pagina
    protected override async Task OnInitializedAsync()
    {
        try
        {
            veterinarios = await VeterinarioService.ListarAsync();

            sedes = veterinarios
                .Select(v => v.Sede)
                .Where(s => !string.IsNullOrWhiteSpace(s))
                .Distinct()
                .OrderBy(s => s)
                .ToList();
        }
        catch (Exception)
        {
            mensajeError = "No se pudieron cargar los veterinarios. Inténtalo nuevamente.";
        }
        finally
        {
            cargando = false;
        }
    }

    // Filtrar horarios por mañana o tarde
    private bool CoincideHorario(string horario)
    {
        if (string.IsNullOrEmpty(horarioFiltro))
            return true;

        if (!TimeOnly.TryParse(horario, out var hora))
            return false;

        if (horarioFiltro == "manana")
            return hora.Hour < 12;

        if (horarioFiltro == "tarde")
            return hora.Hour >= 12;

        return true;
    }

    // Consultar la disponibilidad real
    private async Task BuscarDisponibilidad()
    {
        if (consultando)
            return;

        mensajeError = "";
        mostrarResultados = false;
        resultados.Clear();

        if (fechaFiltro.Date < DateTime.Today)
        {
            mensajeError = "Debe seleccionar una fecha futura.";
            return;
        }

        consultando = true;

        try
        {
            // Filtrar los veterinarios por sede
            var veterinariosFiltrados = veterinarios
                .Where(v =>
                    string.IsNullOrEmpty(sedeFiltro) ||
                    v.Sede == sedeFiltro)
                .ToList();

            foreach (var veterinario in veterinariosFiltrados)
            {
                // Consultar horarios desde Java
                var horarios = await DisponibilidadService.ConsultarAsync(
                    veterinario.EmpleadoId,
                    fechaFiltro,
                    duracionMinutos);

                // Aplicar filtro de mañana o tarde
                var horariosFiltrados = horarios
                    .Where(h => CoincideHorario(h))
                    .ToList();

                // Mostrar solo veterinarios con horas libres
                if (horariosFiltrados.Count > 0)
                {
                    resultados.Add(new ResultadoDisponibilidad
                    {
                        Veterinario = veterinario,
                        Horarios = horariosFiltrados
                    });
                }
            }

            mostrarResultados = true;
        }
        catch (InvalidOperationException ex)
        {
            resultados.Clear();
            mensajeError = ex.Message;
        }
        catch (Exception)
        {
            resultados.Clear();
            mensajeError = "No se pudo consultar la disponibilidad. Inténtalo nuevamente.";
        }
        finally
        {
            consultando = false;
        }
    }
    
    private string CrearEnlaceReserva(int empleadoId, string hora)
    {
        return $"/cliente/citas/nueva" +
               $"?empleadoId={empleadoId}" +
               $"&fecha={fechaFiltro:yyyy-MM-dd}" +
               $"&hora={Uri.EscapeDataString(hora)}" +
               $"&duracion={duracionMinutos}";
    }

}
