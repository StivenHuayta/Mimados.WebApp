@page "/cliente/citas/cancelar/{Id:int}"
@rendermode InteractiveServer

@using Mimados.WebApp.Models
@using Mimados.WebApp.Services

@inject ICitaService CitaService

<PageTitle>Cancelar Cita - Mimados</PageTitle>

<div class="container mt-4" style="max-width: 650px;">

    <div class="d-flex justify-content-between align-items-center mb-4 gap-2">
        <h2 class="mb-0">Cancelar Cita</h2>

        <a class="btn btn-secondary" href="/cliente/citas">
            Mis Citas
        </a>
    </div>

    @if (cargando)
    {
        <div class="alert alert-info">
            Cargando cita...
        </div>
    }
    else if (!string.IsNullOrEmpty(mensajeError))
    {
        <div class="alert alert-danger">
            @mensajeError
        </div>
    }

    @if (cita != null)
    {
        <div class="card shadow-sm border-0 bg-white">

            <div class="card-header bg-danger text-white">
                <h5 class="mb-0 text-white">
                    <i class="bi bi-exclamation-triangle me-2"></i>
                    Confirmación de cancelación
                </h5>
            </div>

            <div class="card-body p-4">

                @if (cancelacionConfirmada)
                {
                    <div class="alert alert-success">
                        Cita cancelada correctamente.
                    </div>

                    <a class="btn btn-primary" href="/cliente/citas">
                        Volver a Mis Citas
                    </a>
                }
                else
                {
                    <p>
                        ¿Deseas cancelar la cita
                        <strong>@($"C-{cita.CitaId:D3}")</strong>?
                    </p>

                    <p>
                        <strong>Motivo:</strong> @cita.Motivo
                    </p>

                    <p>
                        <strong>Fecha:</strong>
                        @cita.FechaHoraInicio.ToString("dd/MM/yyyy HH:mm")
                    </p>

                    <p>
                        <strong>Estado:</strong> @cita.Estado
                    </p>

                    @if (PuedeCancelar())
                    {
                        <div class="d-flex justify-content-end gap-2 mt-4">

                            <a class="btn btn-secondary"
                               href="/cliente/citas">
                                Volver
                            </a>

                            <button class="btn btn-danger"
                                    disabled="@procesando"
                                    @onclick="ConfirmarCancelacion">
                                @(procesando ? "Cancelando..." : "Confirmar Cancelación")
                            </button>

                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning">
                            Esta cita no puede cancelarse debido a su estado.
                        </div>
                    }
                }

            </div>
        </div>
    }

</div>

@code {

    [Parameter]
    public int Id { get; set; }

    private Cita? cita;
    private bool cargando = true;
    private bool procesando = false;
    private bool cancelacionConfirmada = false;
    private string mensajeError = "";

    protected override async Task OnParametersSetAsync()
    {
        cargando = true;
        cancelacionConfirmada = false;
        mensajeError = "";
        cita = null;

        try
        {
            cita = await CitaService.ObtenerPorIdAsync(Id);

            if (cita == null)
            {
                mensajeError = "No se encontró la cita.";
            }
        }
        catch (Exception)
        {
            mensajeError = "Error al consultar la cita.";
        }
        finally
        {
            cargando = false;
        }
    }

    private bool PuedeCancelar()
    {
        return cita != null &&
            (cita.Estado == "PROGRAMADA" ||
             cita.Estado == "CONFIRMADA");
    }

    private async Task ConfirmarCancelacion()
    {
        if (procesando || !PuedeCancelar())
            return;

        procesando = true;
        mensajeError = "";

        try
        {
            bool resultado = await CitaService.CancelarAsync(Id);

            if (resultado)
            {
                cancelacionConfirmada = true;
                cita!.Estado = "CANCELADA";
            }
            else
            {
                mensajeError = "No se pudo cancelar la cita.";
            }
        }
        catch (Exception)
        {
            mensajeError = "Error al comunicarse con Java.";
        }
        finally
        {
            procesando = false;
        }
    }
}
