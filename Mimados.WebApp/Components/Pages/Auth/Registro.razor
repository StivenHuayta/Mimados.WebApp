@page "/registro"
@layout Layout.LoginLayout
@rendermode InteractiveServer

@using System.ComponentModel.DataAnnotations
@using Mimados.WebApp.Models
@using Mimados.WebApp.Services

@inject NavigationManager Nav
@inject IAuthValidationService AuthService

<PageTitle>Registro de Cliente - Mimados Vet</PageTitle>

<div class="container my-4" style="max-width: 680px;">
    <div class="card border-0 shadow-lg rounded-4 p-4 p-md-5 bg-white">
        <div class="text-center mb-4">
            <img src="images/logo-mimados.png" alt="Mimados Veterinaria y Petshop" class="img-fluid mb-2" style="max-height: 95px; width: auto;" />
            <h3 class="fw-bold text-dark mb-1">Registro de Nuevo Cliente</h3>
            <p class="text-secondary small">Crea tu cuenta para gestionar la atención de tus mascotas</p>
        </div>

        @if (!string.IsNullOrWhiteSpace(mensajeError))
        {
            <div class="alert alert-danger py-2 mb-3 text-center fw-semibold small" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                @mensajeError
            </div>
        }

        <EditForm Model="@nuevoCliente" OnValidSubmit="Registrar">
            <DataAnnotationsValidator />

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label text-secondary small fw-semibold">DNI:</label>
                    <InputText @bind-Value="nuevoCliente.Dni" class="form-control" placeholder="8 dígitos" maxlength="8" />
                    <ValidationMessage For="@(() => nuevoCliente.Dni)" class="text-danger small" />
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label text-secondary small fw-semibold">Teléfono:</label>
                    <InputText @bind-Value="nuevoCliente.Telefono" class="form-control" placeholder="9 dígitos" maxlength="9" />
                    <ValidationMessage For="@(() => nuevoCliente.Telefono)" class="text-danger small" />
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label text-secondary small fw-semibold">Nombres:</label>
                    <InputText @bind-Value="nuevoCliente.Nombres" class="form-control" placeholder="Tus nombres" />
                    <ValidationMessage For="@(() => nuevoCliente.Nombres)" class="text-danger small" />
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label text-secondary small fw-semibold">Apellidos:</label>
                    <InputText @bind-Value="nuevoCliente.Apellidos" class="form-control" placeholder="Tus apellidos" />
                    <ValidationMessage For="@(() => nuevoCliente.Apellidos)" class="text-danger small" />
                </div>

                <div class="col-12 mb-3">
                    <label class="form-label text-secondary small fw-semibold">Dirección:</label>
                    <InputText @bind-Value="nuevoCliente.Direccion" class="form-control" placeholder="Dirección de residencia" />
                    <ValidationMessage For="@(() => nuevoCliente.Direccion)" class="text-danger small" />
                </div>

                <div class="col-12 mb-3">
                    <label class="form-label text-secondary small fw-semibold">Correo electrónico:</label>
                    <InputText @bind-Value="nuevoCliente.Email" class="form-control" type="email" placeholder="ejemplo@correo.com" />
                    <ValidationMessage For="@(() => nuevoCliente.Email)" class="text-danger small" />
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label text-secondary small fw-semibold">Contraseña:</label>
                    <InputText @bind-Value="nuevoCliente.Password" class="form-control" type="password" placeholder="Mínimo 6 caracteres" />
                    <ValidationMessage For="@(() => nuevoCliente.Password)" class="text-danger small" />
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label text-secondary small fw-semibold">Confirmar Contraseña:</label>
                    <InputText @bind-Value="nuevoCliente.ConfirmarPassword" class="form-control" type="password" placeholder="Repite la contraseña" />
                    <ValidationMessage For="@(() => nuevoCliente.ConfirmarPassword)" class="text-danger small" />
                </div>

                <div class="col-12 mb-4">
                    <label class="form-label text-secondary small fw-semibold">Contacto de Emergencia:</label>
                    <InputText @bind-Value="nuevoCliente.ContactoEmergencia" class="form-control" placeholder="Teléfono de contacto de emergencia (Opcional)" maxlength="9" />
                    <ValidationMessage For="@(() => nuevoCliente.ContactoEmergencia)" class="text-danger small" />
                </div>
            </div>

            <button type="submit" class="btn btn-primary w-100 py-2.5 fw-semibold shadow-sm mb-3" disabled="@cargando">
                @if (cargando)
                {
                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                    <span>Registrando cuenta...</span>
                }
                else
                {
                    <i class="bi bi-person-plus me-1"></i>
                    <span>Crear Cuenta de Cliente</span>
                }
            </button>

            <div class="text-center small pt-2 border-top">
                <span class="text-muted">¿Ya tienes una cuenta? </span>
                <a href="/login" class="fw-semibold text-primary text-decoration-none">Inicia sesión aquí</a>
            </div>
        </EditForm>
    </div>
</div>

@code {
    private ClienteRegistroModel nuevoCliente = new ClienteRegistroModel();
    private string mensajeError = "";
    private bool cargando = false;

    private async Task Registrar()
    {
        mensajeError = "";
        cargando = true;

        try
        {
            var req = new RegistroClienteRequest
            {
                Dni = nuevoCliente.Dni.Trim(),
                Nombres = nuevoCliente.Nombres.Trim(),
                Apellidos = nuevoCliente.Apellidos.Trim(),
                Email = nuevoCliente.Email.Trim(),
                Password = nuevoCliente.Password,
                Telefono = nuevoCliente.Telefono.Trim(),
                Direccion = nuevoCliente.Direccion.Trim(),
                ContactoEmergencia = string.IsNullOrWhiteSpace(nuevoCliente.ContactoEmergencia) ? null : nuevoCliente.ContactoEmergencia.Trim()
            };

            var (exito, mensaje) = await AuthService.RegistrarClienteAsync(req);

            if (exito)
            {
                Nav.NavigateTo("/login?registered=1");
            }
            else
            {
                mensajeError = mensaje ?? "Ocurrió un error al registrar la cuenta.";
            }
        }
        catch (Exception)
        {
            mensajeError = "No se pudo completar el registro. Inténtalo nuevamente.";
        }
        finally
        {
            cargando = false;
        }
    }

    public class ClienteRegistroModel
    {
        [Required(ErrorMessage = "El DNI es obligatorio")]
        [RegularExpression(@"^\d{8}$", ErrorMessage = "El DNI debe tener exactamente 8 dígitos")]
        public string Dni { get; set; } = string.Empty;

        [Required(ErrorMessage = "Los nombres son obligatorios")]
        [StringLength(45, ErrorMessage = "Máximo 45 caracteres")]
        public string Nombres { get; set; } = string.Empty;

        [Required(ErrorMessage = "Los apellidos son obligatorios")]
        [StringLength(45, ErrorMessage = "Máximo 45 caracteres")]
        public string Apellidos { get; set; } = string.Empty;

        [Required(ErrorMessage = "El correo es obligatorio")]
        [EmailAddress(ErrorMessage = "Formato de correo inválido")]
        [StringLength(100, ErrorMessage = "Máximo 100 caracteres")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "El teléfono es obligatorio")]
        [RegularExpression(@"^\d{9}$", ErrorMessage = "El teléfono debe tener exactamente 9 dígitos")]
        public string Telefono { get; set; } = string.Empty;

        [Required(ErrorMessage = "La dirección es obligatoria")]
        [StringLength(60, ErrorMessage = "Máximo 60 caracteres")]
        public string Direccion { get; set; } = string.Empty;

        [RegularExpression(@"^\d{9}$", ErrorMessage = "El contacto de emergencia debe tener 9 dígitos")]
        public string? ContactoEmergencia { get; set; }

        [Required(ErrorMessage = "La contraseña es obligatoria")]
        [MinLength(4, ErrorMessage = "La contraseña debe tener al menos 4 caracteres")]
        public string Password { get; set; } = string.Empty;

        [Required(ErrorMessage = "Debes confirmar tu contraseña")]
        [Compare(nameof(Password), ErrorMessage = "Las contraseñas no coinciden")]
        public string ConfirmarPassword { get; set; } = string.Empty;
    }
}
