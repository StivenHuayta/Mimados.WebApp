@page "/acceso-denegado"

<PageTitle>Acceso Denegado - Mimados Vet</PageTitle>

<div class="container mt-5 text-center">
    <div class="card shadow border-0 mx-auto" style="max-width: 500px; border-radius: 16px;">
        <div class="card-body p-4 p-sm-5">
            <div class="text-danger mb-4">
                <i class="bi bi-shield-slash-fill" style="font-size: 3.5rem;"></i>
            </div>
            <h3 class="fw-bold text-dark mb-2">Acceso Denegado</h3>
            <p class="text-muted small mb-4">
                No tiene los permisos necesarios para acceder a esta sección o el recurso no está disponible para su rol asignado.
            </p>
            <div class="d-flex justify-content-center gap-2">
                <a href="/" class="btn btn-outline-primary px-4 py-2 fw-semibold">
                    <i class="bi bi-house-door-fill me-1"></i>Ir al Inicio
                </a>
                <a href="/auth/logout" class="btn btn-danger px-4 py-2 fw-semibold">
                    <i class="bi bi-box-arrow-right me-1"></i>Cerrar Sesión
                </a>
            </div>
        </div>
    </div>
</div>
