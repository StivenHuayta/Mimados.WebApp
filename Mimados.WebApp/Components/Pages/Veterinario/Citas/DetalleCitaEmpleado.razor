@page "/empleado/citas/detalle/{Id:int}"
@rendermode InteractiveServer

<PageTitle>Detalle de Cita del Personal - Mimados</PageTitle>

<div class="container mt-4" style="max-width: 850px;">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <h2 class="mb-0">Consulta de Cita</h2>
        <a href="/empleado/citas" class="btn btn-secondary"><i class="bi bi-arrow-left me-1"></i> Volver al listado</a>
    </div>
    <div class="card shadow-sm border-0 bg-white">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0 fw-bold text-white">Cita @Codigo</h5>
            <span class="badge bg-white text-primary">@Estado</span>
        </div>
        <div class="card-body p-4">
            <div class="row g-3">
                <div class="col-md-6"><span class="text-muted">Cliente</span><p class="fw-semibold mb-0">@Cliente</p></div>
                <div class="col-md-6"><span class="text-muted">Mascota</span><p class="fw-semibold mb-0">@Mascota</p></div>
                <div class="col-md-6"><span class="text-muted">Servicio</span><p class="fw-semibold mb-0">@Servicio</p></div>
                <div class="col-md-6"><span class="text-muted">Sede</span><p class="fw-semibold mb-0">@Sede</p></div>
                <div class="col-md-6"><span class="text-muted">Fecha y hora</span><p class="fw-semibold mb-0">@FechaHora</p></div>
                <div class="col-md-6"><span class="text-muted">Veterinario asignado</span><p class="fw-semibold mb-0">@Veterinario</p></div>
            </div>
        </div>
        <div class="card-footer bg-white text-end py-3">
            <a class="btn btn-primary fw-bold" href="@($"/empleado/citas/editar/{Id}")"><i class="bi bi-pencil-square me-1"></i> Modificar Cita</a>
        </div>
    </div>
</div>

@code {
    [Parameter] public int Id { get; set; }
    private string Codigo => Id > 0 ? $"C-{Id:D3}" : "-";
    private string Cliente => "";
    private string Mascota => "";
    private string Servicio => "";
    private string Sede => "";
    private string FechaHora => "";
    private string Veterinario => "";
    private string Estado => "Pendiente";
}
