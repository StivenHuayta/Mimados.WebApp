@page "/veterinario/historial"
@page "/veterinario/historial/{MascotaId:int}"
@rendermode InteractiveServer
@inject NavigationManager Navigation

<div class="container-fluid px-0">
    <!-- Encabezado y navegación de regreso -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
        <div>
            <h3 class="m-0 text-dark fw-bold">
                <i class="bi bi-journal-medical text-primary me-2"></i>Historial Clínico del Paciente
            </h3>
            <p class="text-muted small mb-0">Expediente médico veterinario y registro cronológico de atenciones clínicas.</p>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-secondary" @onclick="VolverACitas">
                <i class="bi bi-arrow-left me-1"></i> Volver a Citas
            </button>
            @if (mascotaSeleccionada != null)
            {
                <a href="/veterinario/atenciones/nueva?mascotaId=@mascotaSeleccionada.MascotaId" class="btn btn-primary fw-bold">
                    <i class="bi bi-plus-circle me-1"></i> Nueva Atención
                </a>
            }
        </div>
    </div>

    <!-- Barra de Selección de Paciente / Búsqueda rápida -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body bg-white py-3">
            <div class="row g-3 align-items-center">
                <div class="col-md-5">
                    <label class="form-label fw-bold small text-secondary mb-1">
                        <i class="bi bi-search me-1"></i>Seleccionar Paciente de la Clínica
                    </label>
                    <select class="form-select bg-white" @onchange="OnPacienteCambiado" value="@(mascotaSeleccionada?.MascotaId ?? 0)">
                        @foreach (var m in listaMascotas)
                        {
                            <option value="@m.MascotaId">@m.Nombre (@m.Especie - @m.Raza) • Dueño: @m.NombreCliente</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-bold small text-secondary mb-1">Buscar por Nombre o DNI del Dueño</label>
                    <input type="text" class="form-control bg-white" placeholder="Filtrar paciente..."
                           @bind="filtroBusquedaPaciente" @bind:event="oninput" />
                </div>
                <div class="col-md-3 text-md-end mt-md-4">
                    <button class="btn btn-outline-primary w-100" @onclick="DescargarReportePdf">
                        <i class="bi bi-file-earmark-pdf me-1"></i> Descargar Historial (PDF)
                    </button>
                </div>
            </div>
        </div>
    </div>

    @* Alerta de feedback al descargar *@
    @if (mostrarAlertaPdf)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>
            <strong>Reporte Clínico Generado:</strong> El expediente completo de <strong>@(mascotaSeleccionada?.Nombre)</strong> ha sido procesado para impresión / descarga.
            <button type="button" class="btn-close" @onclick="() => mostrarAlertaPdf = false"></button>
        </div>
    }

    @if (mascotaSeleccionada != null)
    {
        <!-- Ficha de Datos del Paciente (Cabecera Clínica) -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-primary text-white py-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center gap-3">
                        <span class="badge bg-white text-primary rounded-circle p-3 fs-4">
                            <i class="bi @(mascotaSeleccionada.Especie == "CANINO" ? "bi-award-fill" : "bi-stars")"></i>
                        </span>
                        <div>
                            <h4 class="m-0 fw-bold text-white">@mascotaSeleccionada.Nombre</h4>
                            <span class="badge bg-white text-primary me-2">@mascotaSeleccionada.Especie</span>
                            <span class="badge bg-white bg-opacity-25 text-white">@mascotaSeleccionada.Raza</span>
                        </div>
                    </div>
                    <div class="text-end">
                        <span class="badge bg-white text-primary px-3 py-2">
                            <i class="bi bi-shield-check me-1"></i> Paciente Activo
                        </span>
                    </div>
                </div>
            </div>
            <div class="card-body">
                <div class="row g-4">
                    <!-- Columna 1: Datos Fisiológicos -->
                    <div class="col-md-6 border-end">
                        <h6 class="text-uppercase text-muted fw-bold small mb-3 border-bottom pb-1">
                            <i class="bi bi-card-checklist me-1 text-primary"></i> Datos Fisiológicos de la Mascota
                        </h6>
                        <div class="row g-2 small">
                            <div class="col-sm-6">
                                <span class="text-muted">Sexo:</span>
                                <span class="fw-bold text-dark ms-1">@mascotaSeleccionada.Sexo</span>
                            </div>
                            <div class="col-sm-6">
                                <span class="text-muted">Edad aproximada:</span>
                                <span class="fw-bold text-dark ms-1">@mascotaSeleccionada.EdadAnios años</span>
                            </div>
                            <div class="col-sm-6">
                                <span class="text-muted">F. Nacimiento:</span>
                                <span class="fw-bold text-dark ms-1">@(mascotaSeleccionada.FechaNacimiento?.ToString("dd/MM/yyyy") ?? "No registrada")</span>
                            </div>
                            <div class="col-sm-6">
                                <span class="text-muted">Peso referencial:</span>
                                <span class="fw-bold text-dark ms-1">@(mascotaSeleccionada.PesoReferencial?.ToString("0.0") ?? "--") kg</span>
                            </div>
                            <div class="col-12 mt-2">
                                <span class="text-muted">Alergias o Condiciones:</span>
                                <span class="badge badge-mimados-neutral ms-1">@mascotaSeleccionada.Alergias</span>
                            </div>
                        </div>
                    </div>

                    <!-- Columna 2: Datos del Tutor / Propietario -->
                    <div class="col-md-6">
                        <h6 class="text-uppercase text-muted fw-bold small mb-3 border-bottom pb-1">
                            <i class="bi bi-person-circle me-1 text-primary"></i> Información del Propietario
                        </h6>
                        <div class="row g-2 small">
                            <div class="col-sm-6">
                                <span class="text-muted">Tutor:</span>
                                <span class="fw-bold text-dark ms-1">@mascotaSeleccionada.NombreCliente</span>
                            </div>
                            <div class="col-sm-6">
                                <span class="text-muted">DNI:</span>
                                <span class="fw-bold text-dark ms-1">@mascotaSeleccionada.DniCliente</span>
                            </div>
                            <div class="col-sm-6">
                                <span class="text-muted">Teléfono principal:</span>
                                <a href="tel:@mascotaSeleccionada.TelefonoCliente" class="fw-bold text-primary ms-1 text-decoration-none">
                                    <i class="bi bi-telephone me-1"></i>@mascotaSeleccionada.TelefonoCliente
                                </a>
                            </div>
                            <div class="col-sm-6">
                                <span class="text-muted">Tel. Emergencia:</span>
                                <span class="fw-bold text-danger ms-1">
                                    <i class="bi bi-telephone-plus me-1"></i>@mascotaSeleccionada.TelefonoEmergencia
                                </span>
                            </div>
                            <div class="col-12">
                                <span class="text-muted">Dirección:</span>
                                <span class="fw-semibold text-dark ms-1">@mascotaSeleccionada.DireccionCliente</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Línea Cronológica de Atenciones Médicas (Historial) -->
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="fw-bold text-dark m-0">
                <i class="bi bi-clock-history text-primary me-2"></i>Historial de Atenciones Clínicas (@historialAtenciones.Count)
            </h5>
            <div class="input-group" style="max-width: 300px;">
                <span class="input-group-text bg-white"><i class="bi bi-funnel"></i></span>
                <input type="text" class="form-control form-control-sm" placeholder="Filtrar por diagnóstico o síntoma..."
                       @bind="filtroHistorial" @bind:event="oninput" />
            </div>
        </div>

        @if (historialAtenciones.Count == 0)
        {
            <div class="card shadow-sm border-0 text-center py-5">
                <div class="card-body">
                    <i class="bi bi-file-earmark-medical text-muted" style="font-size: 3rem;"></i>
                    <h5 class="mt-3 text-secondary">No se registran atenciones clínicas previas</h5>
                    <p class="text-muted small">Este paciente aún no cuenta con registros de atención veterinaria en su historial.</p>
                    <a href="/veterinario/atenciones/nueva?mascotaId=@mascotaSeleccionada.MascotaId" class="btn btn-primary fw-bold">
                        <i class="bi bi-clipboard-plus me-1"></i> Registrar Primera Atención
                    </a>
                </div>
            </div>
        }
        else
        {
            <div class="timeline-container">
                @foreach (var atencion in AtencionesFiltradas)
                {
                    <div class="card shadow-sm border-0 mb-3 border-start border-4 border-primary">
                        <div class="card-header bg-light py-2 d-flex flex-wrap justify-content-between align-items-center">
                            <div>
                                <span class="fw-bold text-dark fs-6 me-2">
                                    <i class="bi bi-calendar-event text-primary me-1"></i>
                                    @atencion.FechaHoraRegistro.ToString("dd/MM/yyyy HH:mm")
                                </span>
                                <span class="badge badge-mimados-solid me-1">@atencion.ServicioRealizado</span>
                                <span class="badge badge-mimados-neutral">Cita #@atencion.CitaId</span>
                            </div>
                            <div class="text-muted small">
                                <i class="bi bi-person-badge text-secondary me-1"></i>
                                Atendido por: <strong class="text-dark">@atencion.NombreVeterinario</strong> (@atencion.CodigoCmvp)
                            </div>
                        </div>
                        <div class="card-body">
                            <!-- Signos Vitales y Triaje -->
                            <div class="p-2 mb-3 bg-light rounded border d-flex gap-4 flex-wrap">
                                <div>
                                    <span class="text-muted small">Peso registrado:</span>
                                    <span class="fw-bold text-dark ms-1">
                                        <i class="bi bi-speedometer2 text-primary me-1"></i>
                                        @(atencion.PesoActual?.ToString("0.0") ?? "--") kg
                                    </span>
                                </div>
                                <div>
                                    <span class="text-muted small">Temperatura:</span>
                                    <span class="fw-bold text-dark ms-1">
                                        <i class="bi bi-thermometer-half text-primary me-1"></i>
                                        @(atencion.Temperatura?.ToString("0.0") ?? "--") °C
                                    </span>
                                </div>
                                <div class="ms-auto">
                                    <span class="text-muted small">Monto Total:</span>
                                    <span class="badge badge-mimados-primary fs-6 ms-1">S/. @atencion.MontoTotal.ToString("0.00")</span>
                                </div>
                            </div>

                            <div class="row g-3">
                                <!-- Síntomas -->
                                <div class="col-md-6">
                                    <div class="p-3 bg-light rounded border h-100">
                                        <h6 class="fw-bold text-secondary small text-uppercase mb-2">
                                            <i class="bi bi-chat-left-dots text-primary me-1"></i> Anamnesis / Síntomas observados
                                        </h6>
                                        <p class="mb-0 text-dark small">@atencion.Sintomas</p>
                                    </div>
                                </div>

                                <!-- Diagnóstico -->
                                <div class="col-md-6">
                                    <div class="p-3 bg-light rounded border h-100">
                                        <h6 class="fw-bold text-secondary small text-uppercase mb-2">
                                            <i class="bi bi-clipboard2-check text-primary me-1"></i> Diagnóstico Veterinario
                                        </h6>
                                        <p class="mb-0 text-dark small fw-semibold">@atencion.Diagnostico</p>
                                    </div>
                                </div>

                                <!-- Tratamiento Recetado -->
                                <div class="col-12">
                                    <div class="p-3 bg-white rounded border border-primary-subtle shadow-xs">
                                        <h6 class="fw-bold text-primary small text-uppercase mb-2">
                                            <i class="bi bi-capsule text-primary me-1"></i> Tratamiento y Medicación Prescrita
                                        </h6>
                                        <p class="mb-0 text-dark small">@atencion.TratamientoRecetado</p>
                                    </div>
                                </div>

                                <!-- Observaciones y Cuidados -->
                                @if (!string.IsNullOrWhiteSpace(atencion.Observaciones))
                                {
                                    <div class="col-12">
                                        <div class="p-2 px-3 bg-light rounded border">
                                            <span class="text-muted small fw-bold">Observaciones / Recomendaciones:</span>
                                            <span class="text-dark small ms-1">@atencion.Observaciones</span>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    }
</div>

@code {
    [Parameter]
    public int? MascotaId { get; set; }

    private List<Mascota> listaMascotas = new();
    private Mascota? mascotaSeleccionada;
    private List<Atencion> historialAtenciones = new();

    private string filtroBusquedaPaciente = "";
    private string filtroHistorial = "";
    private bool mostrarAlertaPdf = false;

    protected override void OnInitialized()
    {
        CargarDatos();
    }

    protected override void OnParametersSet()
    {
        CargarDatos();
    }

    private void CargarDatos()
    {
        // TODO: Conectar con IMascotaService para cargar pacientes reales
        listaMascotas = new();

        if (MascotaId.HasValue && MascotaId.Value > 0)
        {
            mascotaSeleccionada = listaMascotas.FirstOrDefault(m => m.MascotaId == MascotaId.Value);
        }
        else if (mascotaSeleccionada == null && listaMascotas.Count > 0)
        {
            mascotaSeleccionada = listaMascotas.First();
        }

        ActualizarHistorial();
    }

    private void OnPacienteCambiado(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int id))
        {
            mascotaSeleccionada = listaMascotas.FirstOrDefault(m => m.MascotaId == id);
            ActualizarHistorial();
        }
    }

    private void ActualizarHistorial()
    {
        // TODO: Conectar con servicio real de historial médico
        historialAtenciones = new();
    }

    private IEnumerable<Atencion> AtencionesFiltradas
    {
        get
        {
            if (string.IsNullOrWhiteSpace(filtroHistorial))
            {
                return historialAtenciones;
            }

            var f = filtroHistorial.Trim().ToLower();
            return historialAtenciones.Where(a =>
                (a.Diagnostico?.ToLower().Contains(f) ?? false) ||
                (a.Sintomas?.ToLower().Contains(f) ?? false) ||
                (a.TratamientoRecetado?.ToLower().Contains(f) ?? false) ||
                (a.ServicioRealizado?.ToLower().Contains(f) ?? false));
        }
    }

    private void VolverACitas()
    {
        Navigation.NavigateTo("/empleado/citas");
    }

    private void DescargarReportePdf()
    {
        mostrarAlertaPdf = true;
    }
}

