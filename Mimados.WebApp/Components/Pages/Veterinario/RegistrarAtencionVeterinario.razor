@page "/veterinario/atenciones/nueva"
@rendermode InteractiveServer
@inject NavigationManager Navigation

<div class="container-fluid px-0" style="max-width: 1000px;">
    <!-- Encabezado -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="m-0 text-dark fw-bold">
                <i class="bi bi-clipboard2-pulse text-primary me-2"></i>Registrar Atención Clínica
            </h3>
            <p class="text-muted small mb-0">
                Registro del informe clínico veterinario al finalizar una cita médica y anexión inmediata al historial.
            </p>
        </div>
        <div>
            <button class="btn btn-outline-secondary" @onclick="Volver">
                <i class="bi bi-arrow-left me-1"></i> Cancelar / Volver
            </button>
        </div>
    </div>

    @* Alerta de Éxito al Registrar *@
    @if (guardadoExitoso)
    {
        <div class="card shadow border-0 border-start border-5 border-primary mb-4 bg-white">
            <div class="card-body p-4 text-center">
                <div class="mb-3">
                    <i class="bi bi-check-circle-fill text-primary" style="font-size: 3.5rem;"></i>
                </div>
                <h4 class="fw-bold text-primary mb-2">¡Atención Clínica Registrada con Éxito!</h4>
                <p class="text-muted fs-6 mb-4">
                    Los detalles clínicos han sido anexados satisfactoriamente al expediente médico de 
                    <strong class="text-dark">@mascotaSeleccionada?.Nombre</strong>. 
                    @if (citaSeleccionada != null)
                    {
                        <span>La Cita <strong>#@citaSeleccionada.CitaId</strong> ha sido marcada como <span class="badge badge-mimados-solid">ATENDIDA</span>.</span>
                    }
                </p>
                <div class="d-flex justify-content-center gap-3">
                    <a href="/veterinario/historial/@(mascotaSeleccionada?.MascotaId ?? 1)" class="btn btn-primary fw-bold px-4">
                        <i class="bi bi-journal-medical me-1"></i> Ver Historial de la Mascota
                    </a>
                    <a href="/empleado/citas" class="btn btn-outline-secondary fw-bold px-4">
                        <i class="bi bi-calendar-check me-1"></i> Volver a Citas Asignadas
                    </a>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- Mensaje de Error de Validación -->
        @if (!string.IsNullOrEmpty(mensajeError))
        {
            <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>@mensajeError
                <button type="button" class="btn-close" @onclick="() => mensajeError = string.Empty"></button>
            </div>
        }

        <!-- Resumen del Paciente y Cita Asociada -->
        <div class="card shadow-sm border-0 mb-4 bg-primary text-white">
            <div class="card-body py-3">
                <div class="row align-items-center">
                    <div class="col-md-7 border-end-md">
                        <span class="badge bg-light text-primary text-uppercase fw-bold mb-1">Paciente Seleccionado</span>
                        <div class="d-flex align-items-center gap-3 mt-1">
                            <span class="badge bg-white text-primary rounded-circle p-2 fs-4">
                                <i class="bi @(mascotaSeleccionada?.Especie == "CANINO" ? "bi-award-fill" : "bi-stars")"></i>
                            </span>
                            <div>
                                <h4 class="mb-0 fw-bold text-white">@(mascotaSeleccionada?.Nombre ?? "Seleccione Mascota")</h4>
                                <div class="opacity-75 small">
                                    @(mascotaSeleccionada?.Especie) • @(mascotaSeleccionada?.Raza) • @(mascotaSeleccionada?.Sexo) • Dueño: @(mascotaSeleccionada?.NombreCliente)
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-5 mt-3 mt-md-0 ps-md-4">
                        <span class="badge bg-light text-primary text-uppercase fw-bold mb-1">Personal Veterinario</span>
                        <div class="fw-bold mt-1">Veterinario en turno</div>
                        <div class="opacity-75 small">Pendiente de conectar</div>
                        @if (citaSeleccionada != null)
                        {
                            <div class="mt-1 badge bg-white text-primary">
                                <i class="bi bi-calendar-check me-1"></i> Vinculado a Cita #@citaSeleccionada.CitaId
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Formulario Clínico de Atención (Estructura acorde a la tabla `atencion`) -->
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3 border-bottom">
                <h5 class="card-title m-0 fw-bold text-dark">
                    <i class="bi bi-file-earmark-medical text-primary me-2"></i>Informe de Consulta y Tratamiento
                </h5>
            </div>
            <div class="card-body">
                <form>
                    <!-- Sección Mascota / Cita si no vinieron por parámetro -->
                    @if (CitaId == null && MascotaId == null)
                    {
                        <div class="row mb-4">
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Seleccionar Mascota a Atender <span class="text-danger">*</span></label>
                                <select class="form-select" @onchange="OnCambiarMascota" value="@(mascotaSeleccionada?.MascotaId ?? 0)">
                                    @foreach (var m in listaMascotas)
                                    {
                                        <option value="@m.MascotaId">@m.Nombre (@m.Especie - @m.Raza) - Dueño: @m.NombreCliente</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Servicio Clínico Realizado</label>
                                <select class="form-select" @bind="servicioRealizado">
                                    <option value="Consulta General">Consulta General</option>
                                    <option value="Vacunación">Vacunación</option>
                                    <option value="Desparasitación">Desparasitación</option>
                                    <option value="Dermatología Veterinaria">Dermatología Veterinaria</option>
                                    <option value="Traumatología y Ortopedia">Traumatología y Ortopedia</option>
                                    <option value="Control Rutinario">Control Rutinario</option>
                                </select>
                            </div>
                        </div>
                    }

                    <!-- 1. Triaje y Signos Vitales (peso_actual, temperatura) -->
                    <div class="mb-4">
                        <h6 class="text-uppercase text-secondary fw-bold small border-bottom pb-2">
                            <i class="bi bi-heart-pulse text-danger me-1"></i> 1. Triaje y Signos Vitales
                        </h6>
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label fw-bold small">Peso Actual (kg) <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <input type="number" step="0.1" class="form-control" placeholder="Ej: 15.6" @bind="pesoActual" />
                                    <span class="input-group-text">kg</span>
                                </div>
                                <div class="form-text">Ref. anterior: @(mascotaSeleccionada?.PesoReferencial?.ToString("0.0") ?? "--") kg</div>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-bold small">Temperatura Corporal (°C) <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <input type="number" step="0.1" class="form-control" placeholder="Ej: 38.5" @bind="temperatura" />
                                    <span class="input-group-text">°C</span>
                                </div>
                                <div class="form-text">Rango normal: 37.5°C - 39.2°C</div>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-bold small">Fecha y Hora de Atención</label>
                                <input type="text" class="form-control bg-light" value="@DateTime.Now.ToString("dd/MM/yyyy HH:mm")" readonly />
                            </div>
                        </div>
                    </div>

                    <!-- 2. Anamnesis y Diagnóstico (sintomas, diagnostico) -->
                    <div class="mb-4">
                        <h6 class="text-uppercase text-secondary fw-bold small border-bottom pb-2">
                            <i class="bi bi-clipboard2-check text-primary me-1"></i> 2. Evaluación Clínica
                        </h6>
                        <div class="mb-3">
                            <label class="form-label fw-bold small">Síntomas / Anamnesis (Motivo de consulta) <span class="text-danger">*</span></label>
                            <textarea class="form-control" rows="2" placeholder="Describa los signos clínicos reportados por el propietario y observados en el examen físico..."
                                      @bind="sintomas"></textarea>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold small">Diagnóstico Veterinario <span class="text-danger">*</span></label>
                            <textarea class="form-control" rows="2" placeholder="Diagnóstico definitivo o presuntivo emitido..."
                                      @bind="diagnostico"></textarea>
                        </div>
                    </div>

                    <!-- 3. Tratamiento y Prescripción (tratamiento_recetado, observaciones) -->
                    <div class="mb-4">
                        <h6 class="text-uppercase text-secondary fw-bold small border-bottom pb-2">
                            <i class="bi bi-capsule text-primary me-1"></i> 3. Plan Terapéutico y Prescripción
                        </h6>
                        <div class="mb-3">
                            <label class="form-label fw-bold small">Tratamiento y Medicación Recetada <span class="text-danger">*</span></label>
                            <textarea class="form-control" rows="3" placeholder="Fármacos prescritos, dosificación, frecuencia y duración del tratamiento..."
                                      @bind="tratamientoRecetado"></textarea>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold small">Observaciones y Recomendaciones para el Hogar</label>
                            <textarea class="form-control" rows="2" placeholder="Cuidados dietéticos, reposo, signos de alerta o próxima cita de revisión..."
                                      @bind="observaciones"></textarea>
                        </div>
                    </div>

                    <!-- 4. Liquidación y Monto Total (monto_total) -->
                    <div class="mb-4">
                        <h6 class="text-uppercase text-secondary fw-bold small border-bottom pb-2">
                            <i class="bi bi-cash-stack text-primary me-1"></i> 4. Liquidación del Servicio
                        </h6>
                        <div class="row g-3 align-items-center">
                            <div class="col-md-6">
                                <label class="form-label fw-bold small">Servicio Aplicado</label>
                                <input type="text" class="form-control" @bind="servicioRealizado" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold small">Monto Total a Cobrar (S/.) <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text fw-bold">S/.</span>
                                    <input type="number" step="1.0" class="form-control fw-bold fs-5 text-primary" @bind="montoTotal" />
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="card-footer bg-white py-3 d-flex justify-content-between align-items-center">
                <button type="button" class="btn btn-outline-secondary" @onclick="Volver">
                    <i class="bi bi-x-circle me-1"></i> Cancelar
                </button>
                <button type="button" class="btn btn-primary btn-lg fw-bold px-4" @onclick="GuardarAtencion">
                    <i class="bi bi-check-circle me-1"></i> Guardar Atención y Finalizar Cita
                </button>
            </div>
        </div>
    }
</div>

@code {
    [SupplyParameterFromQuery]
    public int? CitaId { get; set; }

    [SupplyParameterFromQuery]
    public int? MascotaId { get; set; }

    private Cita? citaSeleccionada;
    private Mascota? mascotaSeleccionada;

    // Campos del formulario
    private decimal? pesoActual;
    private decimal? temperatura = 38.5m;
    private string sintomas = "";
    private string diagnostico = "";
    private string tratamientoRecetado = "";
    private string observaciones = "";
    private string servicioRealizado = "Consulta General";
    private decimal montoTotal = 60.00m;

    private string mensajeError = "";
    private bool guardadoExitoso = false;

    protected override void OnInitialized()
    {
        CargarDatosContexto();
    }

    private List<Mascota> listaMascotas = new();

    protected override void OnParametersSet()
    {
        CargarDatosContexto();
    }

    private void CargarDatosContexto()
    {
        // TODO: Conectar con ICitaService y IMascotaService
        if (CitaId.HasValue && CitaId.Value > 0 && citaSeleccionada != null)
        {
            mascotaSeleccionada = listaMascotas.FirstOrDefault(m => m.MascotaId == citaSeleccionada.MascotaId);
            sintomas = $"Atención en consultorio por motivo: {citaSeleccionada.Motivo}";
            servicioRealizado = citaSeleccionada.ServicioSolicitado;
            montoTotal = citaSeleccionada.MontoEstimado;
            pesoActual = mascotaSeleccionada?.PesoReferencial;
            return;
        }

        if (MascotaId.HasValue && MascotaId.Value > 0)
        {
            mascotaSeleccionada = listaMascotas.FirstOrDefault(m => m.MascotaId == MascotaId.Value);
            pesoActual = mascotaSeleccionada?.PesoReferencial;
        }
        else if (mascotaSeleccionada == null)
        {
            mascotaSeleccionada = listaMascotas.FirstOrDefault();
            pesoActual = mascotaSeleccionada?.PesoReferencial;
        }
    }

    private void OnCambiarMascota(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int id))
        {
            mascotaSeleccionada = listaMascotas.FirstOrDefault(m => m.MascotaId == id);
            pesoActual = mascotaSeleccionada?.PesoReferencial;
        }
    }

    private void GuardarAtencion()
    {
        mensajeError = "";

        // Validaciones requeridas
        if (mascotaSeleccionada == null)
        {
            mensajeError = "Debe seleccionar un paciente para registrar la atención.";
            return;
        }

        if (!pesoActual.HasValue || pesoActual.Value <= 0)
        {
            mensajeError = "Por favor ingrese un peso actual válido para el paciente.";
            return;
        }

        if (!temperatura.HasValue || temperatura.Value < 30 || temperatura.Value > 45)
        {
            mensajeError = "Por favor ingrese una temperatura corporal válida (ej: 38.5 °C).";
            return;
        }

        if (string.IsNullOrWhiteSpace(sintomas))
        {
            mensajeError = "El campo de síntomas / anamnesis es obligatorio.";
            return;
        }

        if (string.IsNullOrWhiteSpace(diagnostico))
        {
            mensajeError = "Debe ingresar el diagnóstico emitido por el veterinario.";
            return;
        }

        if (string.IsNullOrWhiteSpace(tratamientoRecetado))
        {
            mensajeError = "Debe indicar el tratamiento y medicación prescrita.";
            return;
        }

        if (montoTotal <= 0)
        {
            mensajeError = "Ingrese un monto total válido para el servicio prestado.";
            return;
        }

        // Crear la entidad de atención clínica acorde a la BD
        var nuevaAtencion = new Atencion
        {
            CitaId = citaSeleccionada?.CitaId ?? 0,
            MascotaId = mascotaSeleccionada.MascotaId,
            EmpleadoId = 0,
            FechaHoraRegistro = DateTime.Now,
            PesoActual = pesoActual.Value,
            Temperatura = temperatura.Value,
            Sintomas = sintomas.Trim(),
            Diagnostico = diagnostico.Trim(),
            TratamientoRecetado = tratamientoRecetado.Trim(),
            Observaciones = observaciones.Trim(),
            MontoTotal = montoTotal,
            ServicioRealizado = servicioRealizado
        };

        // TODO: Enviar nuevaAtencion al servicio REST real
        guardadoExitoso = true;
    }

    private void Volver()
    {
        Navigation.NavigateTo("/empleado/citas");
    }
}

